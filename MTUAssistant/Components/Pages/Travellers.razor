@page "/travellers"
@implements IDisposable
@inject CampaignService Campaigns
@inject CharacterService CharacterStore

<PageTitle>Travellers</PageTitle>
<div class="travellers-page">
    <header class="page-header"><div><h1>Travellers</h1>@if (campaign is not null) { <p>@campaign.Name</p> }</div>
        @if (campaign is not null) { <button type="button" class="btn btn-primary" @onclick="Add" disabled="@busy">Add Traveller</button> }
    </header>
    @if (campaign is null) { <p class="empty-message">Select a campaign to view its Travellers.</p> }
    else
    {
        @if (error is not null) { <p class="error" role="alert">@error</p> }
        @if (editing is { } traveller) { <TravellerDialog @key="traveller" Item="traveller" Campaign="campaign" OnSaved="Saved" OnChanged="RefreshSkills" OnClose="() => editing = null" /> }
        @if (pendingDelete is { } deleting)
        {
            <DeleteConfirmDialog @key="deleting.Id" Title="Delete Traveller" ConfirmText="Delete Traveller" Busy="busy" Error="@error" OnConfirm="Delete" OnCancel="CancelDelete"><p>Delete <strong>@deleting.Name</strong>? This cannot be undone.</p></DeleteConfirmDialog>
        }
        @if (!busy && items.Count == 0) { <p class="empty-message">No Travellers in this campaign yet.</p> }
        else if (items.Count > 0)
        {
            <div class="table-wrap"><table class="table traveller-table">
                <thead><tr><th>Token</th><th class="nowrap-cell">Traveller Name</th><th class="nowrap-cell">Race</th><th class="nowrap-cell">UPP</th><th>Terms Served</th><th>Skills</th><th>Equipment</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
                <tbody>@foreach (var item in items)
                {
                    <tr class="@(item.Inactive ? "inactive-traveller" : null)"><td>@if (CharacterToken.DataUri(item.TokenImage) is { } token) { <img class="token-thumbnail" src="@token" alt="@($"{item.Name} token")" /> }</td><th scope="row" class="nowrap-cell">@item.Name @if (item.Inactive) { <span class="player-name">Inactive</span> } @if (!string.IsNullOrWhiteSpace(item.PlayerName)) { <span class="player-name">@item.PlayerName</span> }</th><td class="nowrap-cell">@item.Race<span class="player-name">Age: @CharacterAge.Calculate(item.Career?.Count ?? 0, item.Birthday, campaign.Year, campaign.Day)</span></td><td class="upp nowrap-cell">@item.Upp</td><td class="terms-served">@foreach (var line in CareerRules.ServiceLines(item.Career)) { <div>@line</div> }</td><td class="skills-summary">@string.Join(", ", (item.Skills ?? []).Select(skill => $"{skill.Name} {skill.Level}"))</td><td class="equipment-summary">@string.Join(", ", (item.Equipment ?? []).Select(e => e.Summary))</td><td class="row-actions"><button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => Edit(item)" disabled="@busy">Edit</button> <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(item)" disabled="@busy">Delete</button></td></tr>
                }</tbody>
            </table></div>
        }
    }
</div>

@code {
    private Campaign? campaign;
    private IReadOnlyList<Character> items = [];
    private Character? editing, pendingDelete;
    private string? error;
    private bool busy, disposed;
    private int version;

    protected override async Task OnInitializedAsync()
    {
        Campaigns.Changed += CampaignChanged;
        try { await SetCampaign((await Campaigns.ListAsync()).FirstOrDefault(c => c.IsActive)); }
        catch (Exception) { error = "Unable to load the active campaign."; }
    }
    private void CampaignChanged(Campaign? value) => _ = InvokeAsync(async () => { await SetCampaign(value); if (!disposed) StateHasChanged(); });
    private async Task SetCampaign(Campaign? value)
    {
        if (campaign?.Id == value?.Id) { campaign = value; return; }
        campaign = value; editing = null; pendingDelete = null; items = []; error = null;
        var request = ++version;
        if (value is null) return;
        try
        {
            var loaded = await CharacterStore.ListAsync(value.Id, equippedOnly: true);
            if (!disposed && request == version) items = loaded;
        }
        catch (Exception) { if (!disposed && request == version) error = "Unable to load Travellers."; }
    }
    private async Task RefreshSkills()
    {
        if (campaign is not { } current) return;
        try
        {
            var loaded = await CharacterStore.ListAsync(current.Id, equippedOnly: true);
            if (campaign?.Id == current.Id) items = loaded;
        }
        catch (Exception) { error = "Unable to refresh the Traveller list."; }
    }
    // The dialog saves the Traveller, its skills and its equipment itself; the page only reloads the list.
    private void Add() { if (campaign is { } current) Edit(new Character(0, current.Id, "", "", "", "", 0)); }
    private void Edit(Character item) { editing = item; pendingDelete = null; error = null; }
    private async Task Saved() { editing = null; await RefreshSkills(); }
    private void ConfirmDelete(Character item) { pendingDelete = item; editing = null; error = null; }
    private void CancelDelete() { pendingDelete = null; error = null; }
    private async Task Delete()
    {
        if (pendingDelete is not { } current || campaign?.Id != current.CampaignId || busy) return;
        busy = true;
        try { await CharacterStore.DeleteAsync(current.CampaignId, current.Id); if (campaign?.Id == current.CampaignId) { items = await CharacterStore.ListAsync(current.CampaignId, equippedOnly: true); pendingDelete = null; error = null; } }
        catch (Exception) { error = "Unable to delete this Traveller."; }
        finally { busy = false; }
    }
    public void Dispose() { disposed = true; version++; Campaigns.Changed -= CampaignChanged; }
}
