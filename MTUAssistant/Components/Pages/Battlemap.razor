@page "/battlemap"
@implements IAsyncDisposable
@using MTUAssistant.Components.Map
@inject MTUAssistant.Services.BattlemapState BattlemapState
@inject CampaignService Campaigns
@inject SceneService ScenesStore
@inject EquipmentService EquipmentStore
@inject CharacterService CharactersStore
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Battlemap</PageTitle>
@if (BattlemapState.Current is { } scene)
{
    <section class="battlemap-page">
        <header><div><h1>@scene.Name</h1><span class="muted">@scene.GridSize px per square · 1.5 m × 1.5 m</span></div>
            <div class="controls">
                @if (!encounter.Active)
                {
                <label>Grid Size (px)<input class="form-control grid-number" type="number" min="1" step="1" @bind="gridSize" @bind:after="SaveGrid" disabled="@(map is null || busy)" /></label>
                <label>Grid colour<input class="form-control form-control-color" type="color" @bind="gridColour" @bind:after="SaveGrid" disabled="@(map is null || busy)" /></label>
                <label>Width (px)<input class="form-control grid-number" type="number" min="0.25" max="@scene.GridSize" step="0.25" @bind="gridWidth" @bind:after="SaveGrid" disabled="@(map is null || busy)" /></label>
                <label>Opacity (%)<input class="form-control grid-number" type="number" min="0" max="100" @bind="gridOpacity" @bind:after="SaveGrid" disabled="@(map is null || busy)" /></label>
                }
                <button class="btn btn-outline-secondary" aria-label="Zoom in" title="Zoom in" @onclick='() => Command("zoomIn")' disabled="@(map is null)">+</button>
                <button class="btn btn-outline-secondary" aria-label="Zoom out" title="Zoom out" @onclick='() => Command("zoomOut")' disabled="@(map is null)">−</button>
                <button class="btn btn-outline-secondary" @onclick='() => Command("fit")' disabled="@(map is null)">Fit</button>
                <a @ref="presentationLink" class="btn btn-outline-secondary present-link" target="_blank" rel="noopener" aria-label="Present battlemap" title="Present battlemap">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3h18a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-7v-2h7V5H3v3H1V5a2 2 0 0 1 2-2ZM1 18a3 3 0 0 1 3 3H1v-3Zm0-4a7 7 0 0 1 7 7H6a5 5 0 0 0-5-5v-2Zm0-4a11 11 0 0 1 11 11h-2a9 9 0 0 0-9-9v-2Z" /></svg>
                </a>
                <button class="btn btn-outline-primary" disabled="@(map is null || busy || encounter.Active)" @onclick="OpenPreEngagement">Begin Encounter</button>
                @if (encounter.Active) { <button class="btn btn-outline-secondary" disabled="@busy" @onclick="ExitEncounter">Exit Encounter</button> }
                @if (encounter.Active) { <button class="btn btn-outline-primary" disabled="@busy" @onclick="NextTurn">Next turn</button> }
                <button class="btn btn-outline-danger" @onclick="Close">Close</button>
            </div>
        </header>
        @if (error is not null) { <p class="error" role="alert">@error</p> }
        <div class="battlemap-workspace">
            <CombatTracker CampaignId="scene.CampaignId" Entries="entries" Npcs="npcs" Encounter="encounter" Disabled="@(map is null || busy)" PlacingId="placingId"
                           AddNpc="AddNpc" AddTravellers="AddTravellers" Place="BeginPlacement" Unplace="Unplace" Remove="RemoveInstance" VisibilityChanged="SetVisibility" NameChanged="RenameInstance" HitPointsChanged="SetHitPoints" SelectedChanged="SelectCombatant" />
            <div class="map-column">
                @if (placingId is not null)
                {
                    <button class="btn btn-sm btn-outline-secondary cancel-placement" @onclick="CancelPlacement">Cancel placement</button>
                }
                <div class="battlemap-host" @ref="host" aria-label="Battlemap image with square grid"></div>
            </div>
            <div class="action-column"><CombatActionsPanel CampaignId="scene.CampaignId" Actor="SelectedActor" Loadout="SelectedLoadout" Entries="entries" Encounter="encounter" Disabled="@(map is null || busy || !encounter.Active || SelectedActor is null || encounter.IsDead(SelectedActor))" CoverChanged="SetBehindCover" HidingChanged="SetHiding" CoverProtectionChanged="SetCoverProtection" ElevatedChanged="SetElevated" UnconsciousChanged="SetUnconscious" SkillsRequested="OpenSkills" EquipRequested="OpenEquipment" EquipDisabled="@(busy || SelectedActor is null)" ResolveRequested="ResolveActions" ResetRequested="ResetActions" ActionSelected="ChooseAction" AutoAttackChanged="SetAutoAttack" AttackTargetChanged="SetAttackTarget" AttackReactionChanged="SetAttackReaction" AttackReactionStanceChanged="SetAttackReactionStance" AttackReactionCoverChanged="SetAttackReactionCover" TargetReactionChanged="SetTargetReaction" TargetReactionStanceChanged="SetTargetReactionStance" TargetReactionCoverChanged="SetTargetReactionCover" TargetChanged="SetTarget" StanceChanged="SetStance" /></div>
        </div>
        @if (editingSkills is { } skilled) { <CombatSkillsDialog @key="skilled.Id" Character="skilled" OnChanged="SkillsChanged" OnClose="() => editingSkills = null" /> }
        @if (equipping is { } equipped) { <CombatEquipmentDialog @key="equipped.Id" Character="equipped" OnChanged="EquipmentChanged" OnClose="() => equipping = null" /> }
        @if (attackResolution is { } attack) { <AttackResolutionDialog @key="attack" Resolution="attack" TargetNumber="@(attackVolleyIndex + 1)" TargetCount="@(attackVolley?.Count ?? 1)" Busy="busy" Error="@error" OnChanged="AttackPreviewChanged" OnApply="ApplyAttackDamage" OnCancel="CancelAttack" /> }
        @if (preEngagement)
        {
            <div class="encounter-backdrop">
                <section class="encounter-dialog" role="dialog" aria-modal="true" aria-labelledby="engagement-title">
                    <h2 id="engagement-title">Pre-engagement</h2>
                    <label><input type="checkbox" @bind="enemyAware" /> Enemy aware of the Travellers</label>
                    <label><input type="checkbox" @bind="travellersAware" /> Travellers aware of the Enemy</label>
                    <label>Traveller Tactics (Military) Effect<input class="form-control" type="number" @bind="travellerTactics" disabled="@(!travellersAware || !TacticsTravellers.Any())" aria-describedby="traveller-tactics-skills" /></label>
                    <p id="traveller-tactics-skills" class="tactics-skills">@(TacticsTravellers.Any() ? string.Join("; ", TacticsTravellers.Select(e => $"{e.Name}: {TacticsSkills(e)}")) : "No Traveller has Tactics or Tactics (Military).")</p>
                    <p>Enter each Traveller's Initiative (DEX/INT) roll Effect, excluding Tactics and ambush modifiers.</p>
                    <button type="button" class="btn btn-sm btn-outline-primary auto-initiative" @onclick="AutoRollTravellers">Auto-Roll Initiative &amp; Tactics</button>
                    @foreach (var traveller in entries.Where(e => !e.IsNpc))
                    {
                        <label>@traveller.Name<input class="form-control" type="number" @bind="travellerRolls[traveller.Id]" /></label>
                    }
                    <button class="btn btn-primary" disabled="@busy" @onclick="BeginEncounter">Begin Encounter</button>
                    <button class="btn btn-outline-secondary" @onclick="() => preEngagement = false">Cancel</button>
                </section>
            </div>
        }
    </section>
}
else { <p>No scene is open. <a href="scenes">Choose a scene</a>.</p> }

@code {
    [SupplyParameterFromQuery(Name = "campaign")] public int? ResumeCampaignId { get; set; }
    [SupplyParameterFromQuery(Name = "scene")] public int? ResumeSceneId { get; set; }
    private readonly Encounter encounter = new();
    private bool preEngagement, enemyAware = true, travellersAware = true;
    private int travellerTactics;
    private IEnumerable<SceneCombatant> TacticsTravellers => entries.Where(e => !e.IsNpc && Encounter.TravellerTacticsLevel(e).HasValue);
    private static string TacticsSkills(SceneCombatant e) => string.Join(", ", new[] { e.Tactics.HasValue ? $"Tactics {e.Tactics}" : null, e.MilitaryTactics.HasValue ? $"Tactics (Military) {e.MilitaryTactics}" : null }.Where(s => s is not null));
    private readonly Dictionary<int, int> travellerRolls = [];
    private void OpenPreEngagement() { foreach (var e in entries.Where(e => !e.IsNpc)) travellerRolls[e.Id] = 0; travellerTactics = 0; preEngagement = true; }
    private void AutoRollTravellers()
    {
        var result = Encounter.RollTravellers(entries, travellersAware);
        foreach (var roll in result.Initiative) travellerRolls[roll.Key] = roll.Value;
        travellerTactics = result.Tactics;
    }
    private Task ChangeEncounter(Action change) => Run(async scene =>
    {
        var previous = encounter.Snapshot();
        try
        {
            change();
            await ScenesStore.SaveEncounterAsync(scene.CampaignId, scene.Id, encounter.Snapshot());
        }
        catch { encounter.Restore(previous, entries); throw; }
        if (map is not null) await SyncEncounterMap();
    });
    private async Task BeginEncounter()
    {
        await CancelPlacement();
        await ChangeEncounter(() => encounter.Begin(entries, enemyAware, travellersAware, TacticsTravellers.Any() ? travellerTactics : 0, travellerRolls));
        if (encounter.Active) preEngagement = false;
    }
    private Task ExitEncounter() => ChangeEncounter(() => encounter.Exit(entries));
    private Task NextTurn() => ChangeEncounter(() => encounter.Next(entries));
    private Task SelectCombatant(int id) => encounter.Active && entries.Any(e => e.Id == id && encounter.IsDead(e)) ? Task.CompletedTask : ChangeEncounter(() => encounter.SelectCombatant(id, entries));
    private SceneCombatant? SelectedActor => entries.FirstOrDefault(e => e.Id == encounter.SelectedId);
    private Task ChooseAction((int Column, string Action) choice) => SelectedActor is { } actor ? ChangeEncounter(() => encounter.ChooseAction(actor.Id, choice.Action, entries, choice.Column, SelectedLoadout?.HasSmartTracker == true)) : Task.CompletedTask;
    private Character? editingSkills;
    private Character? equipping;
    private Task OpenEquipment() => Run(async scene =>
    {
        if (SelectedActor is not { } actor) return;
        var character = (await CharactersStore.ListAsync(scene.CampaignId, npcs: actor.IsNpc)).FirstOrDefault(c => c.Id == actor.CharacterId)
            ?? throw new ArgumentException("This combatant is no longer in the campaign.");
        editingSkills = null;
        equipping = character with { Name = actor.Name };
    });
    private Task OpenSkills() => Run(async scene =>
    {
        if (SelectedActor is not { } actor) return;
        if (map is not null) await map.InvokeVoidAsync("flushTokenMoves");
        var character = (await CharactersStore.ListAsync(scene.CampaignId, npcs: actor.IsNpc)).FirstOrDefault(c => c.Id == actor.CharacterId)
            ?? throw new ArgumentException("This combatant is no longer in the campaign.");
        equipping = null;
        editingSkills = character with { Name = actor.Name };
    });
    private Task SkillsChanged() => Run(async scene =>
    {
        entries = (await ScenesStore.CombatantsAsync(scene.CampaignId, scene.Id)).ToList();
        await SyncEncounterMap();
    });
    private Task EquipmentChanged() => Run(async scene =>
    {
        if (equipping is not { } character) return;
        loadouts[character.Id] = new CombatLoadout(await EquipmentStore.ListDetailsForCharacterAsync(scene.CampaignId, character.Id));
        await SyncEncounterMap();
    });
    private AttackResolution? attackResolution;
    private List<AttackResolution>? attackVolley;
    private int attackVolleyIndex;
    private async Task ResolveActions()
    {
        if (SelectedActor is not { } actor || attackResolution is not null) return;
        if (encounter.ActionFor(actor.Id).MajorAction is not ("Melee Attack" or "Ranged Attack"))
        {
            await Run(async scene =>
            {
                if (map is not null) await map.InvokeVoidAsync("flushTokenMoves");
                var previous = encounter.Snapshot();
                try
                {
                    encounter.ResolveActions(actor.Id, entries, SelectedLoadout?.HasSmartTracker == true, AttackModifierCalculator.Calculate(encounter, actor, entries, SelectedLoadout));
                    await ScenesStore.SaveEncounterAsync(scene.CampaignId, scene.Id, encounter.Snapshot());
                }
                catch { encounter.Restore(previous, entries); throw; }
                automaticMoveBefore = null;
                if (map is not null) await map.InvokeVoidAsync("resetTokenMovement", actor.Id);
                await SyncEncounterMap();
            });
            return;
        }
        await Run(async scene =>
        {
            if (map is not null) await map.InvokeVoidAsync("flushTokenMoves");
            loadouts[actor.CharacterId] = new CombatLoadout(await EquipmentStore.ListDetailsForCharacterAsync(scene.CampaignId, actor.CharacterId));
            encounter.RefreshAutoWeapon(actor.Id, loadouts[actor.CharacterId].AutoScore, entries);
            var slots = encounter.ActionFor(actor.Id).AttackTargets;
            if (slots[0].TargetId is null) throw new ArgumentException("Choose a target before resolving the attack.");
            var volley = new List<AttackResolution>();
            for (var index = 0; index < slots.Count; index++)
            {
                if (slots[index].TargetId is not int targetId) continue;
                var target = entries.First(e => e.Id == targetId);
                var character = (await CharactersStore.ListAsync(scene.CampaignId, npcs: target.IsNpc)).FirstOrDefault(c => c.Id == target.CharacterId)
                    ?? throw new ArgumentException("The target is no longer in the campaign.");
                loadouts[target.CharacterId] = new CombatLoadout(await EquipmentStore.ListDetailsForCharacterAsync(scene.CampaignId, target.CharacterId));
                volley.Add(encounter.BeginAttack(actor.Id, entries, loadouts[actor.CharacterId], loadouts[target.CharacterId], character.NaturalDr, character.InjuryTolerance, index));
            }
            attackVolley = volley;
            attackVolleyIndex = 0;
            attackResolution = volley[0];
        });
    }
    private async Task AttackPreviewChanged()
    {
        if (attackResolution is not { } attack) return;
        encounter.PreviewAttack(attack.ActorId, attack.Outcome, attack.TargetIndex);
        await SyncEncounterMap();
    }
    private async Task CancelAttack()
    {
        if (busy || attackResolution is not { } attack) return;
        encounter.PreviewAttack(attack.ActorId, null);
        attackResolution = null;
        attackVolley = null;
        attackVolleyIndex = 0;
        error = null;
        await SyncEncounterMap();
    }
    private async Task ApplyAttackDamage()
    {
        if (busy || attackResolution is not { Ready: true } attack || attackVolley is null) return;
        if (attackVolleyIndex + 1 < attackVolley.Count)
        {
            attackResolution = attackVolley[++attackVolleyIndex];
            await AttackPreviewChanged();
            return;
        }
        await ChangeEncounter(() => encounter.ApplyAttacks(attackVolley, entries, SelectedLoadout?.HasSmartTracker == true));
        if (encounter.ActionFor(attack.ActorId).ActionsResolved)
        {
            attackResolution = null;
            attackVolley = null;
            attackVolleyIndex = 0;
            automaticMoveBefore = null;
            if (map is not null) await map.InvokeVoidAsync("resetTokenMovement", attack.ActorId);
        }
    }
    private Task SetBehindCover(bool value) => SelectedActor is { } actor ? ChangeEncounter(() => encounter.SetCoverStatus(actor.Id, value, encounter.ActionFor(actor.Id).SelectedHiding, entries)) : Task.CompletedTask;
    private Task SetCoverProtection(CombatCover? cover) => SelectedActor is { } actor ? ChangeEncounter(() => encounter.SetCoverProtection(actor.Id, cover, entries)) : Task.CompletedTask;
    private Task SetTargetReactionCover(CombatCover? cover) => SelectedActor is { } actor ? ChangeEncounter(() => encounter.SetTargetReactionCover(actor.Id, cover, entries)) : Task.CompletedTask;
    private Task SetHiding(bool value) => SelectedActor is { } actor ? ChangeEncounter(() => encounter.SetCoverStatus(actor.Id, value || encounter.ActionFor(actor.Id).SelectedBehindCover, value, entries)) : Task.CompletedTask;
    private Task SetUnconscious(bool value) => SelectedActor is { } actor ? ChangeEncounter(() => encounter.SetUnconscious(actor.Id, value, entries)) : Task.CompletedTask;
    private Task SetElevated(bool value) => SelectedActor is { } actor ? ChangeEncounter(() => encounter.SetElevated(actor.Id, value, entries)) : Task.CompletedTask;
    private Task ResetActions() => Run(async scene =>
    {
        if (map is not null) await map.InvokeVoidAsync("flushTokenMoves");
        if (SelectedActor is not { } actor) return;
        var previous = encounter.Snapshot();
        var state = encounter.ActionFor(actor.Id);
        SceneCombatant? returned = null;
        try
        {
            encounter.ResetActions(actor.Id, entries);
            if (actor.OnMap && state.TurnOriginColumn is int column && state.TurnOriginRow is int row)
                returned = await ScenesStore.PositionCombatantAsync(scene.CampaignId, scene.Id, actor.Id, column, row, encounter.Snapshot());
            else
                await ScenesStore.SaveEncounterAsync(scene.CampaignId, scene.Id, encounter.Snapshot());
        }
        catch { encounter.Restore(previous, entries); throw; }
        automaticMoveBefore = null;
        if (returned is not null)
        {
            var index = entries.FindIndex(e => e.Id == actor.Id);
            if (index >= 0) entries[index] = returned;
            if (map is not null) await map.InvokeVoidAsync("updateCombatant", returned);
        }
        if (map is not null) await map.InvokeVoidAsync("resetTokenMovement", actor.Id);
        await SyncEncounterMap();
    });
    private Task SetAutoAttack(string mode) => SelectedActor is { } actor ? ChangeEncounter(() => encounter.SetAutoAttack(actor.Id, mode, SelectedLoadout?.AutoScore ?? 0, entries)) : Task.CompletedTask;
    private Task SetAttackTarget((int Index, int? TargetId) value) => SelectedActor is { } actor ? ChangeEncounter(() => encounter.SetAttackTarget(actor.Id, value.Index, value.TargetId, entries)) : Task.CompletedTask;
    private Task SetAttackReaction((int Index, string Reaction) value) => SelectedActor is { } actor ? ChangeEncounter(() => encounter.SetAttackReaction(actor.Id, value.Index, value.Reaction, entries)) : Task.CompletedTask;
    private Task SetAttackReactionCover((int Index, CombatCover? Cover) value) => SelectedActor is { } actor ? ChangeEncounter(() => encounter.SetAttackReactionCover(actor.Id, value.Index, value.Cover, entries)) : Task.CompletedTask;
    private Task SetAttackReactionStance((int Index, string Stance) value) => SelectedActor is { } actor ? ChangeEncounter(() => encounter.SetAttackReactionStance(actor.Id, value.Index, value.Stance, entries)) : Task.CompletedTask;
    private Task SetTarget(int? target) => SelectedActor is { } actor ? ChangeEncounter(() => encounter.SetTarget(actor.Id, target, entries)) : Task.CompletedTask;
    private Task SetTargetReaction(string reaction) => SelectedActor is { } actor ? ChangeEncounter(() => encounter.SetTargetReaction(actor.Id, reaction, entries)) : Task.CompletedTask;
    private Task SetTargetReactionStance(string stance) => SelectedActor is { } actor ? ChangeEncounter(() => encounter.SetTargetReactionStance(actor.Id, stance, entries)) : Task.CompletedTask;
    private Task SetStance(string stance) => SelectedActor is { } actor ? ChangeEncounter(() => encounter.SetStance(actor.Id, stance, entries)) : Task.CompletedTask;
    private Task SetHitPoints((int Id, int Hp) change) => ChangeEncounter(() => encounter.SetHp(change.Id, change.Hp, entries));
    private readonly Dictionary<int, CombatLoadout> loadouts = [];
    private CombatLoadout? SelectedLoadout => SelectedActor is { } actor ? loadouts.GetValueOrDefault(actor.CharacterId) : null;
    private async Task SyncEncounterMap()
    {
        if (BattlemapState.Current is not { } scene) return;
        foreach (var id in entries.Select(e => e.CharacterId).Distinct().Where(id => !loadouts.ContainsKey(id)))
            loadouts[id] = new CombatLoadout(await EquipmentStore.ListDetailsForCharacterAsync(scene.CampaignId, id));
        if (SelectedActor is { } selectedActor) { encounter.RefreshAutoWeapon(selectedActor.Id, SelectedLoadout?.AutoScore ?? 0, entries); encounter.PruneAutoTargets(selectedActor.Id, entries); }
        if (map is null) return;
        await map.InvokeVoidAsync("setEncounterState", encounter.Active, encounter.SelectedId, entries.Where(encounter.IsDead).Select(e => e.Id).ToArray(), encounter.Round, encounter.PlayerTracker(entries), entries.Select(e => new { e.Id, HealthWidth = encounter.HealthWidth(e), HealthColour = encounter.HealthColour(e) }).ToArray(), encounter.MovementRanges(entries), encounter.SelectedId is int selected ? encounter.ActionFor(selected).TargetIds : [], SelectedActor is { } actor && encounter.ActionFor(actor.Id).MajorAction == "Ranged Attack" ? SelectedLoadout?.RangeFor(encounter.ActionFor(actor.Id)) : null, CombatActionSummary.Create(encounter, SelectedActor, entries, SelectedLoadout, player: true), entries.Where(e => encounter.ActionFor(e.Id).Unconscious).Select(e => e.Id).ToArray(), encounter.AutomaticMoveFor(entries));
    }
    private ElementReference host, presentationLink;
    private IJSObjectReference? module, map;
    private string? loadedKey, error;
    private bool ready, disposed, initializing, busy;
    private IReadOnlyList<SceneNpcChoice> npcs = [];
    private List<SceneCombatant> entries = [];
    private SceneSummary? tokenScene;
    private DotNetObjectReference<Battlemap>? callback;
    private int? placingId;
    private string gridColour = "#000000";
    private double gridWidth = 2;
    private int gridSize = 100;
    private int gridOpacity = 50;

    protected override async Task OnInitializedAsync()
    {
        BattlemapState.Changed += Changed;
        try
        {
            var scene = BattlemapState.Current;
            if (scene is null && ResumeCampaignId is int campaignId && ResumeSceneId is int sceneId)
            {
                var active = (await Campaigns.ListAsync()).FirstOrDefault(c => c.IsActive);
                if (active?.Id == campaignId)
                {
                    scene = await ScenesStore.FindAsync(campaignId, sceneId);
                    if (scene is not null) BattlemapState.Open(scene);
                }
            }
            if (scene is null) { Navigation.NavigateTo("scenes"); return; }
            var current = await ScenesStore.FindAsync(scene.CampaignId, scene.Id);
            if (disposed) return;
            if (current is null) { await Close(); return; }
            loadouts.Clear();
            await ScenesStore.PruneInactiveTravellersAsync(current.CampaignId, current.Id);
            entries = (await ScenesStore.CombatantsAsync(current.CampaignId, current.Id)).ToList();
            var savedEncounter = await ScenesStore.LoadEncounterAsync(current.CampaignId, current.Id);
            if (savedEncounter is not null) encounter.Restore(savedEncounter, entries);
            npcs = await ScenesStore.NpcChoicesAsync(current.CampaignId);
            if (disposed) return;
            tokenScene = current; SetGridFields(current);
            BattlemapState.Update(current); ready = true;
            if (ResumeCampaignId != current.CampaignId || ResumeSceneId != current.Id)
                Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
                {
                    ["campaign"] = current.CampaignId,
                    ["scene"] = current.Id,
                }), replace: true);
        }
        catch (Exception) { error = "Unable to load this scene. Return to Scenes and try again."; }
    }
    private void Changed() => _ = InvokeAsync(async () =>
    {
        if (disposed) return;
        if (BattlemapState.Current is null) { if (map is not null) await map.InvokeVoidAsync("closePresentation"); Navigation.NavigateTo("scenes"); }
        else StateHasChanged();
    });
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!ready || disposed || initializing || BattlemapState.Current is not { } scene) return;
        var key = $"{scene.CampaignId}.{scene.Id}.{scene.Revision}.{BattlemapState.OpenVersion}";
        if (key == loadedKey) return;
        initializing = true;
        try
        {
            if (map is not null) { await map.InvokeVoidAsync("dispose"); await map.DisposeAsync(); map = null; }
            module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/Battlemap.js");
            callback ??= DotNetObjectReference.Create(this);
            map = await module.InvokeAsync<IJSObjectReference>("createBattlemap", host,
                $"api/scenes/{scene.CampaignId}/{scene.Id}/image?v={scene.Revision}", scene, key, entries.Where(e => e.OnMap), callback, new { readOnly = false }, presentationLink);
            await SyncEncounterMap();
            loadedKey = key;
            if (disposed) { await map.InvokeVoidAsync("dispose"); await map.DisposeAsync(); map = null; }
            else { error = null; StateHasChanged(); }
        }
        catch (JSDisconnectedException) { }
        catch (Exception) { loadedKey = key; error = "Unable to display the Battlemap. Return to Scenes and reopen it."; if (!disposed) StateHasChanged(); }
        finally { initializing = false; }
    }
    [JSInvokable]
    public Task SelectMapToken(int id) => InvokeAsync(async () =>
    {
        if (disposed || !entries.Any(e => e.Id == id && e.OnMap)) return;
        await SelectCombatant(id);
        if (!disposed) StateHasChanged();
    });
    private async Task Command(string action) { if (map is not null) await map.InvokeVoidAsync(action); }
    private async Task BeginPlacement(int id) { if (map is null) return; placingId = id; error = null; await map.InvokeVoidAsync("beginPlacement", id); }
    private async Task CancelPlacement() { placingId = null; if (map is not null) await map.InvokeVoidAsync("cancelPlacement"); }
    private async Task Run(Func<SceneSummary, Task> action)
    {
        if (busy || tokenScene is not { } scene) return;
        busy = true;
        try { await action(scene); error = null; }
        catch (Exception ex) { error = ex is ArgumentException ? ex.Message : "Unable to save this change. Please try again."; }
        finally { busy = false; }
    }
    private Task AddTravellers() => Run(async scene =>
    {
        if (encounter.Active) throw new ArgumentException("Exit the encounter before adding Travellers.");
        await CancelPlacement();
        if (map is not null) await map.InvokeVoidAsync("flushTokenMoves");
        await ScenesStore.MoveTravellersHereAsync(scene.CampaignId, scene.Id);
        var previousTravellers = entries.Where(e => !e.IsNpc).Select(e => e.Id).ToArray();
        entries = (await ScenesStore.CombatantsAsync(scene.CampaignId, scene.Id)).ToList();
        var saved = await ScenesStore.LoadEncounterAsync(scene.CampaignId, scene.Id);
        if (saved is not null) encounter.Restore(saved, entries);
        if (map is not null)
        {
            foreach (var id in previousTravellers.Where(id => !entries.Any(e => e.Id == id))) await map.InvokeVoidAsync("removeToken", id);
            foreach (var entry in entries.Where(e => !e.IsNpc)) await map.InvokeVoidAsync("updateCombatant", entry);
        }
        await SyncEncounterMap();
    });
    private Task AddNpc(int characterId) => Run(async scene =>
    {
        if (map is not null) await map.InvokeVoidAsync("flushTokenMoves");
        var entry = await ScenesStore.AddCharacterAsync(scene.CampaignId, scene.Id, characterId);
        if (entry.IsNpc) entries.Add(entry);
        else
        {
            var saved = await ScenesStore.LoadEncounterAsync(scene.CampaignId, scene.Id);
            entries = (await ScenesStore.CombatantsAsync(scene.CampaignId, scene.Id)).ToList();
            if (saved is not null) encounter.Restore(saved, entries);
        }
        await SyncEncounterMap();
    });
    private async Task UpdateEntry(SceneCombatant entry)
    {
        var index = entries.FindIndex(e => e.Id == entry.Id);
        if (index >= 0) entries[index] = entry;
        if (map is not null) { await map.InvokeVoidAsync("updateCombatant", entry); await SyncEncounterMap(); }
    }
    private Task SetVisibility((int Id, bool Visible) change) => Run(async scene =>
    {
        if (map is not null) await map.InvokeVoidAsync("flushTokenMoves");
        await UpdateEntry(await ScenesStore.SetCombatantVisibilityAsync(scene.CampaignId, scene.Id, change.Id, change.Visible));
    });
    private Task RenameInstance((int Id, string Name) change) => Run(async scene =>
    {
        if (map is not null) await map.InvokeVoidAsync("flushTokenMoves");
        await UpdateEntry(await ScenesStore.RenameNpcInstanceAsync(scene.CampaignId, scene.Id, change.Id, change.Name));
    });
    private Task Unplace(int id) => Run(async scene =>
    {
        if (placingId == id) await CancelPlacement();
        if (map is not null) await map.InvokeVoidAsync("flushTokenMoves");
        await UpdateEntry(await ScenesStore.PositionCombatantAsync(scene.CampaignId, scene.Id, id, null, null));
    });
    private Task RemoveInstance(int id) => Run(async scene =>
    {
        if (placingId == id) await CancelPlacement();
        if (map is not null) await map.InvokeVoidAsync("flushTokenMoves");
        await ScenesStore.RemoveNpcInstanceAsync(scene.CampaignId, scene.Id, id);
        entries.RemoveAll(e => e.Id == id);
        if (map is not null) { await map.InvokeVoidAsync("removeToken", id); await SyncEncounterMap(); }
    });
    [JSInvokable]
    public async Task<SceneCombatant?> PlaceToken(int id, int column, int row)
    {
        if (disposed || tokenScene is not { } scene) return null;
        placingId = null;
        try
        {
            var token = await ScenesStore.PositionCombatantAsync(scene.CampaignId, scene.Id, id, column, row);
            if (disposed) return token;
            var index = entries.FindIndex(e => e.Id == id); if (index >= 0) entries[index] = token;
            if (encounter.AnchorMovement(id, column, row)) await ScenesStore.SaveEncounterAsync(scene.CampaignId, scene.Id, encounter.Snapshot());
            await SyncEncounterMap();
            error = null; StateHasChanged(); return token;
        }
        catch (Exception) { error = "Unable to save the placement. Please try again."; if (!disposed) StateHasChanged(); return null; }
    }
    private (int Id, int Round, CombatantActionState State)? automaticMoveBefore;
    [JSInvokable]
    public async Task<bool> PreviewAutomaticMove(int id, int column, int row, int round, int originColumn, int originRow)
    {
        if (disposed || busy || attackResolution is not null || encounter.AutomaticMoveFor(entries) is not { } context
            || context.Id != id || context.Round != round || context.Column != originColumn || context.Row != originRow) return false;
        if (automaticMoveBefore is not { } prior || prior.Id != id || prior.Round != round) automaticMoveBefore = (id,round,encounter.ActionFor(id));
        if (!encounter.SetAutomaticMovement(id,column,row,round,originColumn,originRow,entries)) return false;
        await SyncEncounterMap();
        StateHasChanged();
        return true;
    }
    [JSInvokable]
    public async Task CancelAutomaticMove(int id, int round)
    {
        if (automaticMoveBefore is not { } previous || previous.Id != id || previous.Round != round) return;
        if (encounter.Round == round && encounter.SelectedId == id) encounter.CancelAutomaticMovement(id,previous.State);
        automaticMoveBefore = null;
        if (!disposed) { await SyncEncounterMap(); StateHasChanged(); }
    }
    [JSInvokable]
    public async Task<bool> MoveToken(int id, int column, int row, int? automaticRound, int? originColumn, int? originRow)
    {
        if (disposed || tokenScene is not { } scene) return false;
        var previous = automaticMoveBefore is { } saved && saved.Id == id && saved.Round == encounter.Round ? saved.State : encounter.ActionFor(id);
        var moveCommitted = false;
        try
        {
            if (encounter.Active)
            {
                encounter.EnsureTurnOrigin(id, entries);
                if (automaticRound is int round && originColumn is int startColumn && originRow is int startRow)
                    encounter.SetAutomaticMovement(id,column,row,round,startColumn,startRow,entries);
            }
            var token = await ScenesStore.PositionCombatantAsync(scene.CampaignId, scene.Id, id, column, row, encounter.Active ? encounter.Snapshot() : null);
            moveCommitted = true;
            if (automaticMoveBefore?.Id == id) automaticMoveBefore = null;
            if (!disposed) { var index = entries.FindIndex(e => e.Id == id); if (index >= 0) entries[index] = token; await SyncEncounterMap(); error = null; StateHasChanged(); }
            return true;
        }
        catch (Exception)
        {
            if (moveCommitted) { error = "The move was saved, but the display could not be refreshed."; if (!disposed) StateHasChanged(); return true; }
            encounter.CancelAutomaticMovement(id,previous);
            if (automaticMoveBefore?.Id == id) automaticMoveBefore = null;
            error = "Unable to save the move. The token has returned to its previous square.";
            if (!disposed) { await SyncEncounterMap(); StateHasChanged(); }
            return false;
        }
    }
    private void SetGridFields(SceneSummary scene) { gridSize = scene.GridSize; gridColour = scene.GridColour.ToLowerInvariant(); gridWidth = scene.GridlineWidth; gridOpacity = scene.GridOpacity; }
    private async Task SaveGrid()
    {
        await Run(async scene =>
        {
            try
            {
                if (map is not null) await map.InvokeVoidAsync("flushTokenMoves");
                if (placingId is not null && gridSize != scene.GridSize) await CancelPlacement();
                tokenScene = await ScenesStore.SaveGridAsync(scene.CampaignId, scene.Id, gridColour, gridWidth, gridOpacity, gridSize);
                BattlemapState.Update(tokenScene);
                if (map is not null) await map.InvokeVoidAsync("setGrid", tokenScene);
            }
            catch { SetGridFields(scene); throw; }
        });
    }
    private async Task Close() { if (map is not null) await map.InvokeVoidAsync("closePresentation"); BattlemapState.Close(); Navigation.NavigateTo("scenes"); }
    public async ValueTask DisposeAsync()
    {
        disposed = true; BattlemapState.Changed -= Changed;
        try { if (map is not null) { await map.InvokeVoidAsync("dispose"); await map.DisposeAsync(); } if (module is not null) await module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
        callback?.Dispose();
    }
}
