@implements IAsyncDisposable
@inject EquipmentService EquipmentStore
@inject IJSRuntime JS

@* Adds armour or a weapon to a character, or (from a table's Options button) changes the quantity and
   attachments of one already carried. The item can be chosen only while adding. *@
<dialog @ref="dialog" class="sheet sheet-dialog options-dialog" aria-labelledby="equipment-options-heading">
    <form @onsubmit="Save" @onsubmit:preventDefault>
        <h2 id="equipment-options-heading" class="sheet-title">@Title</h2>
        <p class="hint">@Character.Name</p>
        @if (error is not null) { <p class="error" role="alert">@error</p> }
        <div class="item-fields">
            <label class="item-label">@KindName <select class="form-select" @bind:get="model.Equipment.Id" @bind:set="Choose" disabled="@(busy || !Adding)" required>
                @if (Adding)
                {
                    <option value="0">Select @(IsArmour ? "armour" : "a weapon")</option>
                    @foreach (var item in Choices.Where(e => e.Kind == Kind)) { <option value="@item.Id">@Describe(item)</option> }
                }
                else { <option value="@model.Equipment.Id">@Describe(model.Equipment)</option> }
            </select></label>
            <label class="quantity-label">Quantity <input class="form-control" type="number" min="1" step="1" required @bind="model.Quantity" disabled="@busy" /></label>
        </div>
        @if (model.Equipment.Id != 0 && !string.IsNullOrWhiteSpace(model.Equipment.Traits)) { <p class="hint">Traits: @model.Equipment.Traits</p> }
        @if (!IsArmour)
        {
            @if (model.SupportsAttachments)
            {
                <fieldset disabled="@busy">
                    <legend>Attached options</legend>
                    <div class="options-grid">
                        <label><input type="checkbox" @bind="model.Scope" /> Scope</label>
                        <label><input type="checkbox" @bind="model.TargetingSystem" /> Targeting System</label>
                        <label><input type="checkbox" @bind="model.LaserSight" /> Laser Sights</label>
                        <label><input type="checkbox" @bind="model.HolographicSight" /> Holographic Sights</label>
                        <label><input type="checkbox" @bind="model.Fof" /> Friend-or-Foe (FOF)</label>
                        <label><input type="checkbox" @bind="model.Phud" /> Personal Heads-up Display (P-HUD)</label>
                        <label><input type="checkbox" @bind="model.SmartTracker" /> Smart Tracker</label>
                        <label><input type="checkbox" @bind="model.XRayOutliningAid" /> X-Ray Outlining Aid</label>
                    </div>
                    <p class="hint">Smart Tracker includes Intelligent Weapon.</p>
                </fieldset>
            }
            else if (model.Equipment.Id != 0) { <p class="hint">Attachments are available for non-melee weapons only.</p> }
        }
        <div class="actions">
            <button type="button" class="btn btn-outline-secondary" @onclick="Cancel" disabled="@busy">Cancel</button>
            <button type="submit" class="btn btn-primary" disabled="@(busy || model.Equipment.Id == 0)">@(Adding ? $"Add {KindName}" : "Save")</button>
        </div>
    </form>
</dialog>

@code {
    [Parameter, EditorRequired] public Character Character { get; set; } = default!;
    /// <summary>The item carried, or when adding, the starting choice (Equipment.Id 0 for none yet).</summary>
    [Parameter, EditorRequired] public CharacterEquipmentDetails Item { get; set; } = default!;
    [Parameter] public bool Adding { get; set; }
    /// <summary>Armour or Weapon. When editing, the item's own kind is used.</summary>
    [Parameter] public EquipmentKind Kind { get; set; } = EquipmentKind.Armour;
    /// <summary>Catalogue items that can be added: those the character doesn't carry yet.</summary>
    [Parameter] public IReadOnlyList<EquipmentItem> Choices { get; set; } = [];
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    private bool IsArmour => Kind == EquipmentKind.Armour;
    private string KindName => IsArmour ? "Armour" : "Weapon";
    private string Title => Adding ? $"Add {KindName.ToLowerInvariant()}" : $"{KindName} options · {model.Equipment.Name}";
    private static string Describe(EquipmentItem item) =>
        $"{item.Name} · TL {item.Tl} — {(item.Kind == EquipmentKind.Armour ? $"DR {item.FormatProtection()}" : $"{(item.Range == 0 ? "Melee" : $"{item.Range} m")}, {item.Damage}")}";
    private CharacterEquipmentDetails model = new();
    private ElementReference dialog;
    private IJSObjectReference? module;
    private DotNetObjectReference<CharacterEquipmentDialog>? reference;
    private bool busy;
    private string? error;
    protected override void OnInitialized()
    {
        if (!Adding && Item.Equipment.Id != 0) Kind = Item.Equipment.Kind;
        model = Item.Copy();
        ClearUnsupported();
    }
    private void ClearUnsupported()
    {
        if (!model.SupportsAttachments)
            model.Scope = model.TargetingSystem = model.LaserSight = model.HolographicSight = model.Fof = model.Phud = model.SmartTracker = model.XRayOutliningAid = false;
    }
    // The item is init-only, so choosing another one starts a new record that keeps the quantity and any
    // attachments already ticked (they are cleared if the new item can't take them).
    private void Choose(int id)
    {
        var item = Choices.FirstOrDefault(e => e.Id == id && e.Kind == Kind) ?? new EquipmentItem();
        model = new()
        {
            Equipment = item, Quantity = model.Quantity, Equipped = model.Equipped,
            Scope = model.Scope, TargetingSystem = model.TargetingSystem, LaserSight = model.LaserSight, HolographicSight = model.HolographicSight,
            Fof = model.Fof, Phud = model.Phud, SmartTracker = model.SmartTracker, XRayOutliningAid = model.XRayOutliningAid,
        };
        ClearUnsupported();
        error = null;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/EquipmentDialog.js");
            reference = DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync("open", dialog, reference);
        }
        catch (JSDisconnectedException) { }
    }
    [JSInvokable] public async Task Cancel() { if (!busy) await OnClose.InvokeAsync(); }
    private async Task Save()
    {
        if (busy) return;
        if (model.Equipment.Id == 0) { error = $"Choose {(IsArmour ? "the armour" : "a weapon")} to add."; return; }
        busy = true;
        try
        {
            ClearUnsupported();
            if (Adding) await EquipmentStore.AddToCharacterAsync(Character.CampaignId, Character.Id, model);
            else await EquipmentStore.SaveCharacterDetailsAsync(Character.CampaignId, Character.Id, model);
            await OnSaved.InvokeAsync();
        }
        catch (ArgumentException ex) { error = ex.Message; }
        catch (Exception) { error = Adding ? $"Unable to add this {KindName.ToLowerInvariant()}." : "Unable to save equipment options."; }
        finally { busy = false; }
    }
    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            try { await module.InvokeVoidAsync("close", dialog); await module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        reference?.Dispose();
    }
}
