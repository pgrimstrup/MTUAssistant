@page "/"
@using MTUAssistant.Components.Map
@inject MTUAssistant.Services.SelectedWorldState WorldState
@inject SystemDataProvider SystemData

<PageTitle>Galaxy Map</PageTitle>

<div class="world-layout">
    <MapView WorldSelected="SelectWorld" SystemId="SystemId" SectorId="SectorId" SubsectorId="SubsectorId" FocusToken="FocusToken" />
    <SystemDataPanel World="selectedWorld" />
</div>

@code {
    [SupplyParameterFromQuery(Name = "system")] public int? SystemId { get; set; }
    [SupplyParameterFromQuery(Name = "sector")] public int? SectorId { get; set; }
    [SupplyParameterFromQuery(Name = "subsector")] public int? SubsectorId { get; set; }
    [SupplyParameterFromQuery(Name = "focus")] public string? FocusToken { get; set; }
    private SelectedWorld? selectedWorld;
    protected override void OnInitialized() => selectedWorld = WorldState.World;
    private void SelectWorld(SelectedWorld? world) { selectedWorld = world; WorldState.World = world; }
}
