@implements IAsyncDisposable
@inject NpcService Characters
@inject CharacterService CharacterStore
@inject SceneService Scenes
@inject IJSRuntime JS

<dialog @ref="dialog" class="sheet npc-dialog" aria-labelledby="npc-dialog-heading">
    <header class="sheet-toolbar">
        <h2 id="npc-dialog-heading">@(IsNew ? "Add Character" : "Edit Character")</h2>
        <div class="actions">
            <button type="button" class="btn btn-outline-secondary" @onclick="Cancel" disabled="@busy">@(IsNew ? "Cancel" : "Close")</button>
            <button type="button" class="btn btn-primary" @onclick="Save" disabled="@busy">@(IsNew ? "Add Character" : "Save")</button>
        </div>
    </header>
    <div class="sheet-body">
        @if (error is not null) { <p class="error" role="alert">@error</p> }
        <section class="sheet-panel" aria-label="Personal data">
            <div class="sheet-bar"><span>01 / Personal Data</span><span class="sheet-bar-note">@NpcTypes.Label(npcType) record</span></div>
            <div class="sheet-personal">
                <div class="sheet-personal-main">
                    <div class="sheet-fields identity">
                        <label><span class="sheet-label">Name</span><input class="sheet-input sheet-name" @bind="name" maxlength="120" placeholder="Name" disabled="@busy" /></label>
                        <label><span class="sheet-label">Race</span><select class="form-select sheet-input" @bind="race" @bind:after="ChangeRace" disabled="@(busy || !IsNew)">
                            @if (!NpcRaces.All.Contains(race)) { <option value="@race">@race</option> }
                            @foreach (var choice in NpcRaces.All) { <option value="@choice">@choice</option> }
                        </select></label>
                        <label><span class="sheet-label">Age</span><input class="sheet-input" type="number" min="0" @bind="age" placeholder="—" disabled="@busy" /></label>
                        <label><span class="sheet-label">Gender</span><input class="sheet-input" @bind="gender" @bind:after="RefreshGeneratedName" maxlength="120" disabled="@busy" /></label>
                    </div>
                    <div class="sheet-divider"></div>
                    <div class="sheet-fields ratings">
                        <label><span class="sheet-label">NPC Type</span><select class="form-select sheet-input" @bind="npcType" @bind:after="ChangeNpcType" disabled="@(busy || !IsNew)">
                            @foreach (var type in Enum.GetValues<NpcType>()) { <option value="@type">@NpcTypes.Label(type)</option> }
                        </select></label>
                        <label><span class="sheet-label">Skill Level</span><select class="form-select sheet-input" @bind="skillLevel" @bind:after="UpdateGeneratedSkills" disabled="@(busy || !IsNew)">
                            @foreach (var level in Enum.GetValues<NpcSkillLevel>()) { <option value="@level">@((int)level + 1) — @level</option> }
                        </select></label>
                        <label><span class="sheet-label">Occupation</span><select class="form-select sheet-input" @bind="occupation" @bind:after="ChangeOccupation" disabled="@(busy || !IsNew)">
                            @if (!NpcGenerator.Occupations(npcType).Contains(occupation)) { <option value="@occupation">@(string.IsNullOrEmpty(occupation) ? "Unspecified" : occupation)</option> }
                            @foreach (var profession in NpcGenerator.Occupations(npcType)) { <option value="@profession">@(string.IsNullOrEmpty(profession) ? "Unspecified" : profession)</option> }
                        </select></label>
                        <label title="Day of the year, 1 to 365"><span class="sheet-label">Birthday (day)</span><input class="sheet-input" type="number" min="1" max="@CharacterAge.DaysInYear" step="1" @bind="birthday" disabled="@busy" /></label>
                        <label><span class="sheet-label">Speed (m)</span><input class="sheet-input" type="number" min="0" step="1" @bind="speed" disabled="@busy" /></label>
                        <label><span class="sheet-label">Natural DR</span><input class="sheet-input" type="number" min="0" @bind="naturalDr" disabled="@busy" /></label>
                    </div>
                    <div class="sheet-fields quirks">
                        <label><span class="sheet-label">Quirks 1</span><input class="sheet-input" @bind="quirks1" maxlength="500" placeholder="—" disabled="@busy" /></label>
                        <label><span class="sheet-label">Quirks 2</span><input class="sheet-input" @bind="quirks2" maxlength="500" placeholder="—" disabled="@busy" /></label>
                    </div>
                    <label class="description"><span class="sheet-label">Description</span><textarea class="sheet-input" rows="3" placeholder="Appearance, manner, background" @bind="description" disabled="@busy"></textarea></label>
                    <InjuryToleranceEditor @bind-Value="injuryTolerance" Disabled="busy" />
                </div>
                <div class="sheet-personal-token">
                    <span class="sheet-label">Token</span>
                    @if (CharacterToken.DataUri(tokenImage) is { } preview) { <img class="sheet-token" src="@preview" alt="Token preview" /> }
                    else { <div class="sheet-token" aria-hidden="true">No token</div> }
                    <label class="sheet-token-pick @(busy ? "disabled" : null)">@(tokenImage is null ? "Add token" : "Replace token")<InputFile @key="tokenInputKey" accept="image/png,image/jpeg,image/gif,image/webp" OnChange="SelectToken" disabled="@busy" /></label>
                    @if (tokenImage is not null) { <button type="button" class="sheet-link-button" @onclick="RemoveToken" disabled="@busy">Remove token</button> }
                    <span class="sheet-hint">PNG, JPEG, GIF or WebP · 2 MB</span>
                </div>
            </div>
        </section>
        <CharacteristicCards Scores="scores" Extra="@extraDigits" Current="currentStats" Disabled="busy" IdPrefix="npc" />
        <section class="sheet-panel sheet-records" aria-label="Character records">
            <TabBar TValue="NpcTab" Tabs="Tabs" @bind-Active="activeTab" IdPrefix="npc" AriaLabel="Character records" TabBadge="Badge">
                <Extras>03 / Service record</Extras>
                <ChildContent>
                    @if (!IsNew && !recordsLoaded) { <p class="empty-message">Loading…</p> }
                    else if (activeTab == NpcTab.Career)
                    {
                        @if (IsNew) { <p class="empty-message">Add the character first, then record career terms here.</p> }
                        else { <CharacterCareer @key="activeTab" Character="current.Character" OnChanged="RecordsChanged" /> }
                    }
                    else if (!IsNew && activeTab == NpcTab.Skills) { <CharacterSkills @key="activeTab" Character="current.Character" Embedded="true" OnChanged="RecordsChanged" /> }
                    else if (!IsNew) { <CharacterEquipment @key="activeTab" Character="current.Character" Kind="@TabKind" OnChanged="RecordsChanged" /> }
                    else if (activeTab == NpcTab.Skills)
                    {
                        @* A new NPC's skills are generated and saved with it; they become editable once it exists. *@
                        <section class="generated" aria-label="Generated skills">
                            @if (generatedArchetype is not null) { <p class="secondary">@(string.IsNullOrEmpty(generatedArchetype.D66) ? "Combatant" : $"D66 {generatedArchetype.D66}") · @NpcGenerator.SkillRollCount(skillLevel) skill rolls using 2D. Changing occupation rerolls skills. @(NpcRaces.SupportsGeneration(race) ? "Changing skill level rerolls skills, age and UPP." : "Changing skill level rerolls skills.")</p> }
                            <p>@(GeneratedSkills.Length == 0 ? "No generated skills." : string.Join(", ", GeneratedSkills))</p>
                            <p class="secondary">Add the character to edit its skills.</p>
                        </section>
                    }
                    else
                    {
                        var loadout = (current.Character.Equipment ?? []).Where(e => e.Kind == TabKind).ToArray();
                        <section class="generated" aria-label="@($"Generated {TabNoun}")">
                            @if (npcType != NpcType.Combatant) { <p class="secondary">Add the character first, then record @TabNoun here.</p> }
                            else if (loadout.Length > 0) { <p>@string.Join(", ", loadout.Select(e => e.Summary))</p><p class="secondary">Marked Worn or Equipped when the character is added.</p> }
                            else { <p class="secondary">No compatible @TabNoun in the Supply Catalog.</p> }
                        </section>
                    }
                </ChildContent>
            </TabBar>
        </section>
    </div>
</dialog>

@code {
    private enum NpcTab { Career, Skills, Armour, Weapons }
    private static readonly NpcTab[] Tabs = [NpcTab.Career, NpcTab.Skills, NpcTab.Armour, NpcTab.Weapons];

    [Parameter, EditorRequired] public Npc Item { get; set; } = default!;
    /// <summary>The Supply Catalog, used to pick a generated Combatant's loadout.</summary>
    [Parameter] public IReadOnlyList<EquipmentItem> Catalogue { get; set; } = [];
    /// <summary>The details were saved and the dialog should close.</summary>
    [Parameter] public EventCallback OnSaved { get; set; }
    /// <summary>Something was saved while the dialog stays open: a new NPC, a skill or equipment.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private NpcTab activeTab = NpcTab.Career;
    private Npc current = default!;
    private bool IsNew => current.Character.Id == 0;
    private EquipmentKind TabKind => activeTab == NpcTab.Armour ? EquipmentKind.Armour : EquipmentKind.Weapon;
    private string TabNoun => activeTab == NpcTab.Armour ? "armour" : "weapons";
    private string[] GeneratedSkills => NpcGenerator.RecordedSkills(current.Character.Skills ?? []).OrderBy(s => s.Name, StringComparer.OrdinalIgnoreCase).Select(s => $"{s.Name} {s.Level}").ToArray();
    private NpcArchetype? generatedArchetype;
    private bool skillsRerolled;
    private string? automaticName;
    private string name = "", occupation = "", race = "", gender = "", quirks1 = "", quirks2 = "", description = "";
    // The UPP is stored as text. The scores are edited apart and joined on save; digits after SOC (such as PSI) are kept.
    private string upp = "";
    private int?[] scores = [], savedScores = [];
    private string extraDigits = "";
    private NpcType npcType;
    private NpcSkillLevel skillLevel = NpcSkillLevel.Novice;
    private int? age;
    private int speed = 6, birthday = 1, naturalDr, tokenInputKey;
    // Tab badges and the current STR, DEX and END. The tabs wait for these, so no two queries share the database context at once.
    private CharacterRecordCounts? counts;
    private bool recordsLoaded;
    private CurrentCharacteristics currentStats = CurrentCharacteristics.None;
    private string? Badge(NpcTab tab) => IsNew || counts is not { } c ? null : (tab switch { NpcTab.Career => c.Career, NpcTab.Skills => c.Skills, NpcTab.Armour => c.Armour, _ => c.Weapons }).ToString();
    private InjuryTolerance injuryTolerance;
    private byte[]? tokenImage;
    private bool busy, disposed;
    private string? error;
    private ElementReference dialog;
    private IJSObjectReference? module;
    private DotNetObjectReference<NpcDialog>? reference;

    protected override void OnInitialized()
    {
        Load(Item);
        // A new NPC always comes from the generator, so show what its skills were rolled from,
        // and open on Skills: it has no career to show until it is saved.
        if (IsNew) { generatedArchetype = NpcGenerator.ArchetypeFor(Item); activeTab = NpcTab.Skills; }
    }
    protected override async Task OnInitializedAsync()
    {
        if (IsNew) { recordsLoaded = true; return; }
        try
        {
            counts = await CharacterStore.RecordCountsAsync(current.Character.CampaignId, current.Character.Id);
            currentStats = await Scenes.CurrentCharacteristicsAsync(current.Character.CampaignId, current.Character.Id);
        }
        catch (Exception) { counts = null; }
        finally { recordsLoaded = true; }
    }
    private async Task LoadCounts()
    {
        try { counts = await CharacterStore.RecordCountsAsync(current.Character.CampaignId, current.Character.Id); }
        catch (Exception) { counts = null; }
    }
    // A tab saved something: refresh its badge, then let the page reload its list.
    private async Task RecordsChanged()
    {
        await LoadCounts();
        await OnChanged.InvokeAsync();
    }
    private void Load(Npc item)
    {
        current = item;
        generatedArchetype = null; skillsRerolled = false;
        name = item.Character.Name; occupation = item.Occupation; race = item.Character.Race; gender = item.Gender;
        automaticName = item.Character.Id == 0 ? name : null;
        quirks1 = item.Quirks1; quirks2 = item.Quirks2; skillLevel = item.SkillLevel; age = item.Age; npcType = item.Type;
        injuryTolerance = item.Character.InjuryTolerance; description = item.Character.Description; speed = item.Character.Speed; birthday = item.Character.Birthday; naturalDr = item.Character.NaturalDr;
        tokenImage = item.Character.TokenImage; tokenInputKey++;
        SetUpp(item.Character.Upp);
    }
    private void SetUpp(string value)
    {
        upp = value;
        (scores, extraDigits) = CharacteristicProfile.Split(value);
        savedScores = [.. scores];
    }
    // An untouched profile is saved back as it was, so an unusual stored UPP is never rewritten by accident.
    private string Upp() => scores.SequenceEqual(savedScores) ? upp : CharacteristicProfile.Join(scores, extraDigits);
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/EquipmentDialog.js");
            reference = DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync("open", dialog, reference);
        }
        catch (JSDisconnectedException) { }
    }
    [JSInvokable] public async Task Cancel() { if (!busy) await OnClose.InvokeAsync(); }

    private void UpdateGeneratedSkills()
    {
        if (!IsNew) return;
        ChangeOccupation();
        if (NpcRaces.SupportsGeneration(race)) age = NpcGenerator.GenerateAge(skillLevel);
        RerollUpp();
    }
    private void RerollUpp()
    {
        if (IsNew && NpcRaces.SupportsGeneration(race)) SetUpp(NpcGenerator.GenerateUpp(npcType, race, skillLevel));
    }
    private void ChangeRace()
    {
        if (!IsNew) return;
        if (!NpcRaces.SupportsGeneration(race))
        {
            name = gender = "";
            SetUpp("");
            age = null; automaticName = null;
            return;
        }
        var choices = NpcGenerator.Occupations(npcType);
        if (!choices.Contains(occupation)) occupation = choices[0];
        gender = Random.Shared.Next(1, 7) <= 3 ? "Male" : "Female";
        name = NpcGenerator.GenerateName(race, gender); automaticName = name;
        UpdateGeneratedSkills();
    }
    private void RefreshGeneratedName()
    {
        if (!IsNew || !NpcRaces.SupportsGeneration(race) || name != automaticName) return;
        name = NpcGenerator.GenerateName(race, gender);
        automaticName = name;
    }
    private void ChangeNpcType()
    {
        if (!IsNew) return;
        var choices = NpcGenerator.Occupations(npcType);
        if (!choices.Contains(occupation)) occupation = choices[0];
        ChangeOccupation();
        RerollUpp();
    }
    private void ChangeOccupation()
    {
        if (!IsNew) return;
        if (!NpcGenerator.Occupations(npcType).Contains(occupation)) return;
        generatedArchetype = NpcGenerator.ArchetypeFor(npcType, occupation);
        current = current with { Character = current.Character with { Skills = NpcGenerator.GenerateSkills(generatedArchetype, skillLevel) } };
        var draft = current with { Type = npcType, Occupation = occupation };
        current = current with { Character = current.Character with { Equipment = CombatantLoadouts.Select(draft, Catalogue) } };
        skillsRerolled = true;
    }
    private void RemoveToken() { tokenImage = null; tokenInputKey++; error = null; }
    private async Task SelectToken(InputFileChangeEventArgs args)
    {
        if (busy) return;
        busy = true;
        try
        {
            if (args.File.Size > CharacterToken.MaxBytes) throw new ArgumentException("Choose an image no larger than 2 MB.");
            await using var source = args.File.OpenReadStream(CharacterToken.MaxBytes);
            using var memory = new MemoryStream(); await source.CopyToAsync(memory);
            var bytes = memory.ToArray();
            if (CharacterToken.ContentType(bytes) is null) throw new ArgumentException("Choose a PNG, JPEG, GIF or WebP image.");
            if (disposed) return;
            tokenImage = bytes; error = null;
        }
        catch (ArgumentException ex) { error = ex.Message; }
        catch (Exception) { error = "Unable to read this image. Please choose it again."; }
        finally { busy = false; }
    }
    private async Task Save()
    {
        if (busy) return;
        busy = true;
        try
        {
            var isNew = IsNew;
            var campaignId = current.Character.CampaignId;
            var id = await Characters.SaveAsync(current with { Character = current.Character with { Name = name, Race = race, Upp = Upp(), Speed = speed, Birthday = birthday, NaturalDr = naturalDr, InjuryTolerance = injuryTolerance, TokenImage = tokenImage, Description = description }, Occupation = occupation, Gender = gender, Quirks1 = quirks1, Quirks2 = quirks2, SkillLevel = skillLevel, Age = age, Type = npcType }, replaceSkills: skillsRerolled);
            error = null;
            if (!isNew) { await OnSaved.InvokeAsync(); return; }
            // A new NPC stays open so its generated skills and equipment can be adjusted straight away.
            // Reload it, because saving fills in defaults such as a blank UPP.
            var saved = (await Characters.ListAsync(campaignId)).FirstOrDefault(n => n.Character.Id == id);
            if (saved is null) { await OnSaved.InvokeAsync(); return; }
            recordsLoaded = false;
            Load(saved);
            await LoadCounts();
            recordsLoaded = true;
            await OnChanged.InvokeAsync();
        }
        catch (ArgumentException ex) { error = ex.Message; }
        catch (Exception) { error = "Unable to save this character."; }
        finally { busy = false; }
    }
    public async ValueTask DisposeAsync()
    {
        disposed = true;
        if (module is not null)
        {
            try { await module.InvokeVoidAsync("close", dialog); await module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        reference?.Dispose();
    }
}
