@page "/trading"
@implements IDisposable
@inject CampaignService Campaigns
@inject TradingService TradeService
@inject TravellerService TravellerStore
@inject MTUAssistant.Services.TradingSelectionState TradingState
@inject SystemDataProvider SystemData
@inject MTUAssistant.Services.SelectedWorldState WorldState

<PageTitle>Trading</PageTitle>

<div class="trading-page">
    <header class="trading-header">
        <p class="eyebrow">Commerce</p>
        <h1>Trading</h1>
        @if (world is not null) { <p class="intro">@world.Name · @world.Sector @world.Hex</p> }
        else { <p class="intro">Select a world on the map to begin trading.</p> }
    </header>
    <div class="trade-columns">
        <section class="trade-panel buying" aria-labelledby="buying-heading">
            <header class="panel-header"><div><span class="panel-label">Exports</span><h2 id="buying-heading">Buying</h2></div><div class="header-status">@if (market is not null) { <FreshnessBadge TargetDay="market.TargetDay" Campaign="activeCampaign" /> }<span class="direction" aria-hidden="true">↗</span></div></header>
            <div class="panel-body">
                @if (world is not null)
                {
                    <label class="destination-label">Current world
                        <input class="form-control" value="@($"{world.Name} · {world.Sector} {world.Hex}")" readonly />
                    </label>
                    <div class="badge-row">
                        <div class="badge-group uwp-badges" aria-label="Current world universal world profile">
                            @foreach (var item in UwpLookup.Describe(world.Uwp, world.Pbg))
                            {
                                <span class="world-badge" data-attribute="@item.Name" title="@($"{item.Name}: {item.Description}")">@item.Code</span>
                            }
                        </div>
                        <div class="badge-group trade-badges" aria-label="Current world trade codes and travel zone">
                            @if (ZoneName(CurrentZone()) is { } originZone)
                            {
                                <span class="world-badge zone-badge" data-zone="@originZone">@originZone Zone</span>
                            }
                            @foreach (var tradeCode in TradeCodeLookup.Describe(world.Remarks))
                            {
                                <span class="world-badge trade-badge" data-category="@tradeCode.Category" title="@tradeCode.Name">@tradeCode.Code</span>
                            }
                        </div>
                    </div>
                    <div class="trade-controls">
                        <label>Traveller <select class="form-select traveller-select" @bind="buyTravellerId" disabled="@busy">
                            <option value="0">Select a Traveller</option>
                            @foreach (var traveller in travellers.Where(t => !t.Inactive))
                            {
                                <option value="@traveller.Id">@traveller.TravellerName</option>
                            }
                        </select></label>
                        <label>Mode <select class="form-select" value="@mode" @onchange="ChangeMode" disabled="@busy"><option>Broker</option><option>Streetwise</option></select></label>
                        <label>Skill DM <output class="form-control dm-input" title="Selected Traveller: skill + higher INT or EDU DM; untrained skill −3, reduced by Jack-of-All-Trades (maximum +3)">@FormatSkillDm(skillDm)</output></label>
                        <label>Supplier DM <input class="form-control dm-input" type="number" @bind="supplierDm" disabled="@busy" /></label>
                        <button type="button" class="btn btn-primary" @onclick="Roll" disabled="@(busy || skillDm is null)">Roll</button>
                    </div>
                    @if (error is not null) { <p class="trade-error" role="alert">@error</p> }
                    @if (market is null) { <p>Roll to generate trade goods for this world.</p> }
                    else
                    {
                        <p class="market-summary">@market.Mode · Skill DM @market.SkillDm · Supplier DM @(market.SupplierDm?.ToString() ?? "not recorded") · @market.RandomRolls additional rolls @if (market.TonnageDm is { } buyingDm) { <text>· Supply DM @(buyingDm.ToString("+0;-0;0"))</text> }</p>
                        <div class="table-wrap"><table class="table trade-goods">
                            <thead><tr><th>Trade good</th><th title="World trade-code modifiers applied to the price roll">Trade DMs</th><th>Supply (T)</th><th>Base price / t</th><th>Modifier</th><th>Buy price / t</th></tr></thead>
                            <tbody>@foreach (var good in market.Goods.OrderBy(g => g.PricePercent ?? int.MaxValue).ThenBy(g => g.Name)) {
                                <tr><td>@good.Name @if (good.Illegal) { <span class="tag">Illegal</span> } else if (good.Stolen) { <span class="tag">Stolen</span> }</td><td>@TradePricing.FormatTradeModifiers(good, false)</td><td>@(good.Tons?.ToString("N0") ?? "Referee")</td><td>@(good.BasePrice is { } basePrice ? $"Cr {basePrice:N0}" : "Referee")</td><td>@(good.PricePercent is { } percent ? $"{percent}%" : "Referee")</td><td>@(good.BuyPrice is { } buyPrice ? $"Cr {buyPrice:N0}" : "Referee")</td></tr>
                            }</tbody>
                        </table></div>
                    }
                }
                else { <p>Select a world on the map to generate available goods.</p> }
            </div>
        </section>
        <section class="trade-panel selling" aria-labelledby="selling-heading">
            <header class="panel-header"><div><span class="panel-label">Imports</span><h2 id="selling-heading">Selling</h2></div><div class="header-status">@if (sales is not null) { <FreshnessBadge TargetDay="sales.TargetDay" Campaign="activeCampaign" /> }<span class="direction" aria-hidden="true">↙</span></div></header>
            <div class="panel-body">
                @if (world is null) { <p>Select a world on the map to generate sale prices.</p> }
                else
                {
                    <label class="destination-label">Destination
                        <select class="form-select" value="@destinationId" @onchange="ChangeDestination" disabled="@busy">
                            <option value="0">@world.Name · @world.Sector @world.Hex (current world)</option>
                            @foreach (var destination in destinations) {
                                <option value="@destination.System.Id">@destination.System.MainWorld.Name · @destination.Sector.Name @destination.System.Hex (@destination.Distance pc)</option>
                            }
                        </select>
                    </label>
                    <div class="badge-row">
                        <div class="badge-group uwp-badges" aria-label="Destination world universal world profile">
                            @foreach (var item in UwpLookup.Describe(destination is null ? world.Uwp : destination.System.MainWorld.Uwp, destination is null ? world.Pbg : destination.System.MainWorld.Pbg))
                            {
                                <span class="world-badge" data-attribute="@item.Name" title="@($"{item.Name}: {item.Description}")">@item.Code</span>
                            }
                        </div>
                        <div class="badge-group trade-badges" aria-label="Destination world trade codes and travel zone">
                            @if (ZoneName(destination is null ? CurrentZone() : destination.System.MainWorld.Zone) is { } destinationZone)
                            {
                                <span class="world-badge zone-badge" data-zone="@destinationZone">@destinationZone Zone</span>
                            }
                            @foreach (var tradeCode in TradeCodeLookup.Describe(destination?.System.MainWorld.Remarks ?? world.Remarks))
                            {
                                <span class="world-badge trade-badge" data-category="@tradeCode.Category" title="@tradeCode.Name">@tradeCode.Code</span>
                            }
                        </div>
                    </div>
                    <div class="trade-controls">
                        <label>Traveller <select class="form-select traveller-select" @bind="sellTravellerId" disabled="@busy">
                            <option value="0">Select a Traveller</option>
                            @foreach (var traveller in travellers.Where(t => !t.Inactive))
                            {
                                <option value="@traveller.Id">@traveller.TravellerName</option>
                            }
                        </select></label>
                        <label>Mode <select class="form-select" value="@sellMode" @onchange="ChangeSellMode" disabled="@busy"><option>Broker</option><option>Streetwise</option></select></label><label>Skill DM <output class="form-control dm-input" title="Selected Traveller: skill + higher INT or EDU DM; untrained skill −3, reduced by Jack-of-All-Trades (maximum +3)">@FormatSkillDm(sellSkillDm)</output></label><label>Buyer DM <input class="form-control dm-input" type="number" @bind="buyerDm" disabled="@busy" /></label><button type="button" class="btn btn-primary" @onclick="RollSales" disabled="@(busy || sellSkillDm is null)">Roll</button></div>
                    @if (salesError is not null) { <p class="trade-error" role="alert">@salesError</p> }
                    @if (sales is null) { <p>Roll to find goods this world wants to buy.</p> }
                    else
                    {
                        <p class="market-summary">@sales.Mode · Skill DM @sales.SkillDm · Buyer DM @(sales.BuyerDm?.ToString() ?? "not recorded") @if (sales.TonnageDm is { } demandDm) { <text>· Demand DM @(demandDm.ToString("+0;-0;0"))</text> }</p>
                        <div class="table-wrap"><table class="table trade-goods">
                            <thead><tr><th>Trade good</th><th title="World trade-code modifiers applied to the price roll">Trade DMs</th><th>Demand (T)</th><th>Base price / t</th><th>Modifier</th><th>Sale price / t</th></tr></thead>
                            <tbody>@foreach (var good in sales.Goods.OrderByDescending(g => g.PricePercent ?? int.MinValue).ThenBy(g => g.Name)) {
                                <tr><td>@good.Name @if (good.Illegal) { <span class="tag">Illegal</span> }</td><td>@TradePricing.FormatTradeModifiers(good, true)</td><td>@(good.Tons?.ToString("N0") ?? "Referee")</td><td>@(good.BasePrice is { } basePrice ? $"Cr {basePrice:N0}" : "Referee")</td><td>@(good.PricePercent is { } percent ? $"{percent}%" : "Referee")</td><td>@(good.SalePrice is { } salePrice ? $"Cr {salePrice:N0}" : "Referee")</td></tr>
                            }</tbody>
                        </table></div>
                    }
                }
            </div>
        </section>
    </div>
    <p class="trade-credit">Trade goods based on <a href="https://github.com/timtoon/trade-goods" target="_blank" rel="noopener noreferrer">Trade Goods Dice Modifiers</a> by Tim Heiderich (CC BY-NC 4.0), Mongoose Traveller 2nd edition, 2016.</p>
</div>

@code {
    private Campaign? activeCampaign;
    private void CampaignChanged(Campaign? campaign) => _ = InvokeAsync(async () =>
    {
        selections = campaign is null ? new() : TradingState.ForCampaign(campaign.Id);
        activeCampaign = campaign;
        await LoadTravellers();
        await LoadMarket();
        await LoadSales();
        StateHasChanged();
    });
    private IReadOnlyList<Traveller> travellers = [];
    private static string FormatSkillDm(int? dm) => dm?.ToString("+0;-0;0") ?? "";
    private async Task LoadTravellers()
    {
        travellers = [];
        var campaignId = activeCampaign?.Id;
        if (campaignId is null) return;
        try
        {
            var loaded = await TravellerStore.ListAsync(campaignId.Value);
            if (activeCampaign?.Id == campaignId)
            {
                travellers = loaded;
                if (!loaded.Any(t => t.Id == buyTravellerId && !t.Inactive)) buyTravellerId = 0;
                if (!loaded.Any(t => t.Id == sellTravellerId && !t.Inactive)) sellTravellerId = 0;
            }
        }
        catch (Exception) { error = salesError = "Unable to load active Traveller modifiers."; }
    }
    public void Dispose() => Campaigns.Changed -= CampaignChanged;
    private SelectedWorld? world;
    private MTUAssistant.Services.TradingSelections selections = new();
    private string mode { get => selections.BuyingMode; set => selections.BuyingMode = value; }
    private int buyTravellerId { get => selections.BuyingTravellerId; set => selections.BuyingTravellerId = value; }
    private int sellTravellerId { get => selections.SellingTravellerId; set => selections.SellingTravellerId = value; }
    private int? skillDm => TravellerService.TradingModifier(travellers.Where(t => t.Id == buyTravellerId), mode);
    private string sellMode { get => selections.SellingMode; set => selections.SellingMode = value; }
    private int? sellSkillDm => TravellerService.TradingModifier(travellers.Where(t => t.Id == sellTravellerId), sellMode);
    private int supplierDm = -2;
    private int buyerDm = -2;
    private int destinationId;
    private IReadOnlyList<TradeDestination> destinations = [];
    private TradeDestination? destination => destinations.FirstOrDefault(d => d.System.Id == destinationId);
    private bool isRemoteDestination => destinationId != 0;
    private string? CurrentZone()
    {
        if (world is null) return null;
        var data = SystemData.Catalogue;
        return data.SectorsById.TryGetValue(world.SectorId, out var sector)
            && data.SystemsByHex.TryGetValue((sector.Milieu, sector.X, sector.Y, world.Hex), out var system)
            ? system.MainWorld.Zone : null;
    }
    private static string? ZoneName(string? zone) => zone?.Trim().ToUpperInvariant() switch
    {
        "A" or "AMBER" or "AMBERZONE" => "Amber",
        "R" or "RED" or "REDZONE" => "Red",
        _ => null
    };
    private string CurrentPricingCodes() => TradePricing.WithZone(world?.Remarks, CurrentZone());
    private MarketResult? market;
    private MarketResult? sales;
    private string? salesError;
    private bool busy;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        Campaigns.Changed += CampaignChanged;
        activeCampaign = (await Campaigns.ListAsync()).FirstOrDefault(c => c.IsActive);
        selections = activeCampaign is null ? new() : TradingState.ForCampaign(activeCampaign.Id);
        await LoadTravellers();
        world = WorldState.World;
        if (world is not null) destinations = TradeDestinations.Within(SystemData.Catalogue, world.SectorId, world.Hex);
        await LoadMarket();
        await LoadSales();
    }
    private async Task LoadMarket()
    {
        if (world is null) return;
        busy = true;
        try { market = await TradeService.GetAsync(world.SectorId, world.Hex, mode, CurrentPricingCodes()); supplierDm = market?.SupplierDm ?? -2; error = null; }
        catch (Exception) { error = "Unable to load the saved market."; }
        finally { busy = false; }
    }
    private async Task ChangeMode(ChangeEventArgs args)
    {
        mode = args.Value?.ToString() == "Streetwise" ? "Streetwise" : "Broker";
        market = null;
        await LoadMarket();
    }
    private async Task LoadSales()
    {
        if (world is null) return;
        busy = true;
        try
        {
            var target = destination;
            if (isRemoteDestination && target is null) { salesError = "Destination is no longer available."; return; }
            var sectorId = target?.System.SectorId ?? world.SectorId;
            var hex = target?.System.Hex ?? world.Hex;
            sales = await TradeService.GetSalesAsync(sectorId, hex, sellMode);
            if (sales is not null)
            {

                buyerDm = sales.BuyerDm ?? -2;
            }
            salesError = null;
        }
        catch (Exception) { salesError = "Unable to load the saved sales market."; }
        finally { busy = false; }
    }
    private async Task ChangeDestination(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var id) || (id != 0 && !destinations.Any(d => d.System.Id == id))) return;
        destinationId = id;
        sales = null;
        await LoadSales();
    }
    private async Task ChangeSellMode(ChangeEventArgs args)
    {
        sellMode = args.Value?.ToString() == "Streetwise" ? "Streetwise" : "Broker";
        sales = null;
        await LoadSales();
    }
    private async Task Roll()
    {
        if (world is null || busy) return;
        busy = true;
        try { if (activeCampaign is null) { error = "Select a campaign to generate dated results."; return; } await LoadTravellers(); if (skillDm is not { } modifier) { error = "Select an active Traveller."; return; } market = await TradeService.RollAsync(world.SectorId, world.Hex, mode, modifier, CurrentPricingCodes(), supplierDm, targetDay: CampaignDates.Today(activeCampaign), population: MarketGenerator.PopulationFromUwp(world.Uwp)); error = null; }
        catch (ArgumentException ex) { error = ex.Message; }
        catch (Exception) { error = "Unable to save the generated market. Please try again."; }
        finally { busy = false; }
    }
    private async Task RollSales()
    {
        if (world is null || busy) return;
        busy = true;
        try
        {
            var target = destination;
            if (activeCampaign is null) { salesError = "Select a campaign to generate dated results."; return; }
            if (isRemoteDestination && target is null) { salesError = "Destination is no longer available."; return; }
            await LoadTravellers();
            if (sellSkillDm is not { } modifier) { salesError = "Select an active Traveller."; return; }
            var today = CampaignDates.Today(activeCampaign);
            var targetDay = target is null ? today : CampaignDates.RemoteTarget(today, target.Distance, () => System.Security.Cryptography.RandomNumberGenerator.GetInt32(1, 7));
            sales = await TradeService.RollSalesAsync(target?.System.SectorId ?? world.SectorId,
                target?.System.Hex ?? world.Hex, sellMode, modifier,
                TradePricing.WithZone(target?.System.MainWorld.Remarks ?? world.Remarks, target is null ? CurrentZone() : target.System.MainWorld.Zone),
                buyerDm, targetDay: targetDay, population: MarketGenerator.PopulationFromUwp(target?.System.MainWorld.Uwp ?? world.Uwp));
            salesError = null;
        }
        catch (ArgumentException ex) { salesError = ex.Message; }
        catch (Exception) { salesError = "Unable to save the generated sale prices. Please try again."; }
        finally { busy = false; }
    }

}
