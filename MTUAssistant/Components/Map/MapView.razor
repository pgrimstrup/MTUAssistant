@implements IAsyncDisposable
@inject IJSRuntime JS
@inject WorldSelectionService Worlds
@inject SystemDataProvider SystemData
@inject MTUAssistant.Services.SelectedWorldState WorldState
@inject MTUAssistant.Services.MapPointerLocation PointerLocation
@inject ILogger<MapView> Logger

<div class="map-shell @(ReadOnly ? "presentation-map" : null)">
    <div @ref="host" class="map-host"></div>

    @if (!ReadOnly)
    {
        <div class="map-hud">
            <button type="button" title="Zoom in" aria-label="Zoom in" @onclick="ZoomIn">+</button>
            <button type="button" title="Zoom out" aria-label="Zoom out" @onclick="ZoomOut">&minus;</button>
            <button type="button" title="Fit to screen" aria-label="Fit to screen" @onclick="Fit">&#x26F6;</button>
            <a @ref="presentationLink" class="present-link" target="_blank" rel="noopener" aria-label="Present map" title="Present map">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 3h18a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-7v-2h7V5H3v3H1V5a2 2 0 0 1 2-2ZM1 18a3 3 0 0 1 3 3H1v-3Zm0-4a7 7 0 0 1 7 7H6a5 5 0 0 0-5-5v-2Zm0-4a11 11 0 0 1 11 11h-2a9 9 0 0 0-9-9v-2Z" /></svg>
            </a>
        </div>
    }

    <div class="map-key" aria-label="Map legend">
        <span class="map-key-water">● Water</span>
        <span class="map-key-dry">● Dry / belt</span>
        <span class="map-key-amber">◯ Amber zone</span>
        <span class="map-key-red">◯ Red zone</span>
        <span class="map-key-water">★ Naval · ▲ Scout</span>
    </div>
    <div @ref="status" class="map-status" role="status">Loading world data…</div>
    @if (selectionError is not null)
    {
        <div class="map-selection-error" role="alert">@selectionError</div>
    }

    @if (error is not null)
    {
        <div class="map-error">@error</div>
    }
</div>

@code {
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public string? PresentationSession { get; set; }
    private ElementReference presentationLink;
    private ElementReference host;
    private ElementReference status;
    private IJSObjectReference? module;
    private IJSObjectReference? map;
    private string? error;
    private string? selectionError;
    private DotNetObjectReference<MapView>? callback;
    private long selectionVersion;
    private bool disposed;
    private bool reloadPending;

    protected override void OnInitialized() => SystemData.Reloaded += OnCatalogueReloaded;

    private void OnCatalogueReloaded() => _ = InvokeAsync(async () =>
    {
        if (disposed) return;
        reloadPending = true;
        await ReloadMapData();
    });

    private async Task ReloadMapData()
    {
        if (disposed || map is null || !reloadPending) return;
        reloadPending = false;
        try
        {
            selectionVersion++;
            await map.InvokeVoidAsync("reloadData");
            if (disposed) return;
            if (!ReadOnly) await RestoreWorldSelection();
            selectionError = null;
            StateHasChanged();
        }
        catch (JSDisconnectedException) { }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to reload map data");
            selectionError = "Unable to reload map data. Refresh this page to try again.";
            StateHasChanged();
        }
    }

    [Parameter] public EventCallback<SelectedWorld?> WorldSelected { get; set; }
    [Parameter] public int? SystemId { get; set; }
    [Parameter] public int? SectorId { get; set; }
    [Parameter] public int? SubsectorId { get; set; }
    [Parameter] public string? FocusToken { get; set; }
    private (int? System, int? Sector, int? Subsector, string? Token) lastFocus;

    protected override async Task OnParametersSetAsync()
    {
        var request = (SystemId, SectorId, SubsectorId, FocusToken);
        if (request == lastFocus) return;
        lastFocus = request;
        // Invalidate an older pending selection, including a removed query parameter.
        selectionVersion++;
        if (map is not null) await FocusSearchTarget();
    }

    private async Task RestoreWorldSelection()
    {
        var selected = WorldState.World;
        if (selected is null || map is null) return;
        var version = ++selectionVersion;
        var data = SystemData.Catalogue;
        if (!data.SectorsById.TryGetValue(selected.SectorId, out var sector)
            || sector.Milieu != TileRefreshWorker.Milieu
            || !data.SystemsByHex.ContainsKey((sector.Milieu, sector.X, sector.Y, selected.Hex)))
        {
            await WorldSelected.InvokeAsync(null);
            return;
        }
        var restored = await map.InvokeAsync<bool>("restoreSelection", selected.SectorId, selected.Hex);
        if (disposed || version != selectionVersion) return;
        if (!restored) { await WorldSelected.InvokeAsync(null); return; }
        await SelectHex(sector.X, sector.Y, int.Parse(selected.Hex[..2]), int.Parse(selected.Hex[2..]));
    }

    private async Task FocusSearchTarget()
    {
        if (SystemId is { } systemId) await FocusSystem(systemId);
        else if (SubsectorId is { } subsectorId) await FocusRegion(null, subsectorId);
        else if (SectorId is { } sectorId) await FocusRegion(sectorId, null);
    }

    private async Task FocusRegion(int? sectorId, int? subsectorId)
    {
        var version = ++selectionVersion;
        var data = SystemData.Catalogue;
        string? letter = null;
        if (subsectorId is { } id)
        {
            var subsector = data.Subsectors.FirstOrDefault(s => s.Id == id);
            sectorId = subsector?.SectorId;
            letter = subsector?.Letter;
        }
        if (sectorId is not { } targetId || !data.SectorsById.TryGetValue(targetId, out var sector)
            || sector.Milieu != TileRefreshWorker.Milieu)
        {
            selectionError = "This region is not available on the current map.";
            return;
        }
        try
        {
            var focused = await map!.InvokeAsync<bool>("focusRegion", targetId, letter);
            if (disposed || version != selectionVersion) return;
            if (!focused)
            {
                selectionError = "Unable to locate this region on the map.";
                return;
            }
            selectionError = null;
            await WorldSelected.InvokeAsync(null);
        }
        catch (JSDisconnectedException) { }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to focus searched region");
            if (!disposed && version == selectionVersion)
                selectionError = "Unable to navigate to this region. Please try again.";
        }
    }

    private async Task FocusSystem(int id)
    {
        var version = ++selectionVersion;
        var data = SystemData.Catalogue;
        if (!data.SystemsById.TryGetValue(id, out var system)
            || !data.SectorsById.TryGetValue(system.SectorId, out var sector)
            || sector.Milieu != TileRefreshWorker.Milieu)
        {
            selectionError = "This system is not available on the current map.";
            return;
        }
        try
        {
            var focused = await map!.InvokeAsync<bool>("focusWorld", system.SectorId, system.Hex);
            if (disposed || version != selectionVersion) return;
            if (!focused)
            {
                selectionError = "Unable to locate this system on the map.";
                return;
            }
            await SelectHex(sector.X, sector.Y, int.Parse(system.Hex[..2]), int.Parse(system.Hex[2..]));
        }
        catch (JSDisconnectedException) { }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to focus searched system {SystemId}", id);
            if (!disposed && version == selectionVersion)
                selectionError = "Unable to navigate to this system. Please try again.";
        }
    }

    [JSInvokable]
    public Task SetPointerLocation(string? sector, string? subsector)
    {
        if (!disposed) PointerLocation.Set(sector, subsector);
        return Task.CompletedTask;
    }

    [JSInvokable]
    public async Task ClearPresentationSelection()
    {
        if (disposed || !ReadOnly) return;
        selectionVersion++;
        selectionError = null;
        await WorldSelected.InvokeAsync(null);
    }

    [JSInvokable]
    public async Task SelectHex(int sectorX, int sectorY, int column, int row)
    {
        var version = ++selectionVersion;
        try
        {
            var world = await Worlds.FindAsync(sectorX, sectorY, column, row);
            if (disposed || version != selectionVersion) return;
            selectionError = null;
            await WorldSelected.InvokeAsync(world);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to load selected world");
            if (disposed || version != selectionVersion) return;
            selectionError = "Unable to load world data. Please try again.";
        }
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Map/MapView.razor.js");
            callback = DotNetObjectReference.Create(this);
            map = await module.InvokeAsync<IJSObjectReference>("createMap", host, status, callback, new { readOnly = ReadOnly, session = PresentationSession }, presentationLink);
            if (!disposed)
            {
                if (ReadOnly) { await InvokeAsync(StateHasChanged); return; }
                if (reloadPending) await ReloadMapData();
                else if (SystemId is not null || SectorId is not null || SubsectorId is not null) await FocusSearchTarget();
                else await RestoreWorldSelection();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (JSDisconnectedException)
        {
        }
        catch (Exception ex)
        {
            error = $"Unable to start the map: {ex.Message}";
            StateHasChanged();
        }
    }

    private Task ZoomIn() => Invoke("zoomIn");
    private Task ZoomOut() => Invoke("zoomOut");
    private Task Fit() => Invoke("fit");

    private async Task Invoke(string method)
    {
        if (map is not null) await map.InvokeVoidAsync(method);
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        SystemData.Reloaded -= OnCatalogueReloaded;
        PointerLocation.Set(null, null);
        selectionVersion++;
        try
        {
            if (map is not null)
            {
                await map.InvokeVoidAsync("dispose");
                await map.DisposeAsync();
            }
            if (module is not null) await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
        finally
        {
            callback?.Dispose();
        }
    }
}
