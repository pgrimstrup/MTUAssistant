@using MTU.Core
@inject CoverProtectionService CoverStore

<aside class="combat-actions" aria-label="Combat actions">
    <div class="action-top">
        <div class="actions-heading"><h2>Combat Actions</h2><span class="character-tools"><button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(EquipDisabled || Actor is null)" @onclick="() => DescribeRequested.InvokeAsync()">Describe</button><button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(EquipDisabled || Actor is null)" @onclick="() => SkillsRequested.InvokeAsync()">Skills</button><button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(EquipDisabled || Actor is null || Actor.IsAnimal)" @onclick="() => EquipRequested.InvokeAsync()">Equip</button></span></div>
        @if (Actor is { } actor)
        {
            var state = Encounter.ActionFor(actor.Id);
            <header class="actor-heading">
                <span class="portrait-frame @(Encounter.Active ? actor.IsNpc ? "foe" : "friend" : null)">
                    @if (actor.HasTokenImage) { <img src="@($"api/characters/{CampaignId}/{actor.CharacterId}/token")" alt="" /> }
                    else { <span class="initials">@Initials(actor.Name)</span> }
                </span>
                <div><h3>@actor.Name</h3><p>@(actor.IsNpc ? actor.Occupation : actor.PlayerName)</p><small>Stance: @state.Stance</small></div>
            </header>
            <div class="action-columns">
                @foreach (var group in Groups)
                {
                    <section><h3>@group.Title <span>@(group.Column != 2 ? $"{state.MinorCount}/{(state.MajorAction is null ? 3 : 1)}" : $"{(state.MajorAction is null ? 0 : 1)}/{(state.MinorCount > 1 ? 0 : 1)}")</span></h3>
                        @foreach (var action in group.Actions.Where(a => a != "Tag Target" || Loadout?.HasSmartTracker == true))
                        {
                            <button type="button" class="action-button @(state.IsSelected(action, group.Column) ? "chosen" : null)" disabled="@(Disabled || !Encounter.CanChooseAction(actor.Id, action, Loadout?.HasSmartTracker == true))" aria-pressed="@((state.IsSelected(action, group.Column)).ToString().ToLowerInvariant())" @onclick="() => ActionSelected.InvokeAsync((group.Column, action))">@state.ButtonText(action, group.Column)</button>
                        }
                        @if (group.Column == 2) { <button type="button" class="action-button reset-actions" disabled="@Disabled" @onclick="() => ResetRequested.InvokeAsync()">Reset</button> }
                    </section>
                }
            </div>
            @if (!Encounter.Active) { <p class="hint">Begin an encounter to choose an action.</p> }
            <div class="action-options">
                <fieldset class="combat-status-options" aria-label="Combatant statuses">
                    <label><input type="checkbox" checked="@state.SelectedBehindCover" disabled="@(Disabled || state.ActionsResolved)" @onchange="e => CoverChanged.InvokeAsync(e.Value is true)" /> Behind Cover</label>
                    <label><input type="checkbox" checked="@state.SelectedHiding" disabled="@(Disabled || state.ActionsResolved)" @onchange="e => HidingChanged.InvokeAsync(e.Value is true)" /> Hiding</label>
                    <label><input type="checkbox" checked="@state.SelectedElevated" disabled="@(Disabled || state.ActionsResolved)" @onchange="e => ElevatedChanged.InvokeAsync(e.Value is true)" /> Elevated</label>
                    <label><input type="checkbox" checked="@state.SelectedFlying" disabled="@(Disabled || state.ActionsResolved)" @onchange="e => FlyingChanged.InvokeAsync(e.Value is true)" /> Flying</label>
                    <label><input type="checkbox" checked="@state.Unconscious" disabled="@Disabled" @onchange="e => UnconsciousChanged.InvokeAsync(e.Value is true)" /> Unconscious</label>
                </fieldset>
                @if (state.SelectedHiding)
                {
                    <label>Cover Protection
                        <select class="form-select" value="@(state.SelectedCoverProtection?.Id.ToString() ?? "")" disabled="@(Disabled || state.ActionsResolved || coverError is not null)" @onchange="ChangeCoverProtection">
                            <option value="">None</option>
                            @if (state.SelectedCoverProtection is { } saved && !covers.Any(c => c.Id == saved.Id && c.Name == saved.Name && c.Protection == saved.Protection && c.Hits == saved.Hits))
                            { <option value="@saved.Id">@saved.Name (+@saved.Protection protection; @saved.Hits Hits; saved values)</option> }
                            @foreach (var cover in covers.Where(c => state.SelectedCoverProtection is not { } selected || c.Id != selected.Id || (c.Name == selected.Name && c.Protection == selected.Protection && c.Hits == selected.Hits)))
                            { <option value="@cover.Id">@cover.Name (+@cover.Protection protection; @cover.Hits Hits)</option> }
                        </select>
                    </label>
                    @if (coverError is not null) { <p role="alert">@coverError</p> }
                }
                @if (state.TargetReaction == "Dive for Cover")
                {
                    <label>Reaction Cover Protection
                        <select class="form-select" value="@(state.TargetReactionCover?.Id.ToString() ?? "")" disabled="@(Disabled || state.ActionsResolved || coverError is not null)" @onchange="ChangeTargetReactionCover">
                            <option value="">None</option>
                            @if (state.TargetReactionCover is { } savedReactionCover && !covers.Any(c => c.Id == savedReactionCover.Id && c.Name == savedReactionCover.Name && c.Protection == savedReactionCover.Protection && c.Hits == savedReactionCover.Hits))
                            { <option value="@savedReactionCover.Id">@savedReactionCover.Name (+@savedReactionCover.Protection protection; @savedReactionCover.Hits Hits; saved values)</option> }
                            @foreach (var cover in covers.Where(c => state.TargetReactionCover is not { } selected || c.Id != selected.Id || (c.Name == selected.Name && c.Protection == selected.Protection && c.Hits == selected.Hits)))
                            { <option value="@cover.Id">@cover.Name (+@cover.Protection protection; @cover.Hits Hits)</option> }
                        </select>
                    </label>
                    @if (coverError is not null) { <p role="alert">@coverError</p> }
                }
                @if (actor.IsAnimal && state.MajorAction == "Melee Attack" && Loadout?.NaturalWeapons is { Count: > 1 } naturalWeapons)
                {
                    <label>Attack <select class="form-select" value="@(state.NaturalAttackId ?? naturalWeapons[0].Equipment.Id)" disabled="@(Disabled || state.ActionsResolved)" @onchange="e => NaturalAttackChanged.InvokeAsync(int.Parse(e.Value!.ToString()!))">
                        @foreach (var weapon in naturalWeapons) { <option value="@weapon.Equipment.Id">@weapon.Equipment.Name</option> }
                    </select></label>
                }
                @if (state.MajorAction == "Ranged Attack" && Loadout?.AutoScore > 0)
                {
                    <label class="inline-option"><span>Auto Attack</span><select class="form-select" value="@state.AutoAttack" disabled="@(Disabled || state.ActionsResolved)" @onchange="ChangeAutoAttack">
                        <option value="Single" selected="@(state.AutoAttack == "Single")">Single</option>
                        <option value="Burst" selected="@(state.AutoAttack == "Burst")">Burst (one target, @Loadout.AutoScore rounds)</option>
                        <option value="Full Auto" selected="@(state.AutoAttack == "Full Auto")">Full Auto (multiple targets, @(Loadout.AutoScore * 3) rounds)</option>
                    </select></label>
                }
                @if (state.NeedsTarget)
                {
                    @for (var i = 0; i < state.AttackTargets.Count; i++)
                    {
                        var index = i;
                        var slot = state.AttackTargets[index];
                        <div class="target-options">
                            <label class="inline-option"><span>Target@(state.FullAuto ? $" {index + 1}" : "")</span>
                                <select class="form-select" value="@(slot.TargetId?.ToString() ?? "")" disabled="@(Disabled || state.ActionsResolved)" @onchange="e => ChangeAttackTarget(index, e)">
                                    <option value="" selected="@(slot.TargetId is null)">No target</option>
                                    @foreach (var target in Entries.Where(e => e.Id != actor.Id && (!state.FullAuto || ((e.Id == slot.TargetId || !state.TargetIds.Contains(e.Id)) && (index == 0 || MTU.Core.Encounter.WithinAutoTargetRange(Entries.FirstOrDefault(first => first.Id == state.TargetId), e))))))
                                    { <option value="@target.Id" selected="@(slot.TargetId == target.Id)">@TargetLabel(target)</option> }
                                </select>
                            </label>
                            @if (state.NeedsReaction)
                            {
                                <label class="inline-option"><span>Reaction</span>
                                    <select class="form-select" value="@slot.Reaction" disabled="@(Disabled || state.ActionsResolved || slot.TargetId is null)" @onchange="e => ChangeAttackReaction(index, e)">
                                        @foreach (var reaction in Encounter.TargetReactions) { <option value="@reaction" selected="@(slot.Reaction == reaction)">@reaction</option> }
                                    </select>
                                </label>
                                @if (slot.Reaction == "Dive for Cover" && Entries.FirstOrDefault(e => e.Id == slot.TargetId) is { } reactingTarget)
                                {
                                    <label class="inline-option reaction-stance"><span>Reaction Stance</span>
                                        <select class="form-select" value="@(slot.Stance ?? Encounter.ActionFor(reactingTarget.Id).Stance)" disabled="@(Disabled || state.ActionsResolved)" @onchange="e => ChangeAttackReactionStance(index, e)">
                                            @foreach (var stance in CombatActionChoices.Stances) { <option value="@stance" selected="@((slot.Stance ?? Encounter.ActionFor(reactingTarget.Id).Stance) == stance)">@stance</option> }
                                        </select>
                                    </label>
                                }
                            }
                        </div>
                    }
                }

                @if (state.NeedsStance)
                {
                    <label>Stance
                        <select class="form-select" value="@state.SelectedStance" disabled="@(Disabled || state.ActionsResolved)" @onchange="ChangeStance">
                            @foreach (var stance in CombatActionChoices.Stances) { <option value="@stance" selected="@(state.SelectedStance == stance)">@stance</option> }
                        </select>
                    </label>
                }
                @{
                    var attacks = state.AttackTargets.Select((slot,index) => (slot,index))
                        .Where(t => t.index == 0 || t.slot.TargetId.HasValue)
                        .Select(t => (Name: Entries.FirstOrDefault(e => e.Id == t.slot.TargetId)?.Name ?? "No target", Modifiers: AttackModifierCalculator.Calculate(Encounter, actor, Entries, Loadout, t.index)))
                        .Where(t => t.Modifiers is not null).ToArray();
                    var modifierNames = attacks.SelectMany(t => t.Modifiers!.Rows).Select(row => row.Name).Distinct().ToArray();
                }
                @if (attacks.Length > 0)
                {
                    <table class="attack-modifiers" aria-label="Attack modifiers">
                        <caption>Attack modifiers</caption>
                        <tbody>
                            @foreach (var name in modifierNames)
                            { <tr><td>@name</td><td>@FormatModifiers(attacks.Select(t => t.Modifiers!.Rows.Where(r => r.Name == name).Sum(r => r.Dm)))</td></tr> }
                        </tbody>
                        <tfoot><tr><th scope="row">Total</th><td>@FormatModifiers(attacks.Select(t => t.Modifiers!.Total))</td></tr></tfoot>
                    </table>
                    @if (state.FullAuto) { <p class="hint">@string.Join(" / ", attacks.Select(t => t.Name))</p> }
                    @foreach (var reason in attacks.Select(t => t.Modifiers!.UnavailableReason).OfType<string>().Distinct()) { <p class="hint">@reason</p> }
                }
                <button type="button" class="btn btn-sm btn-primary resolve-actions" disabled="@(Disabled || state.ActionsResolved || (state.MinorCount == 0 && state.MajorAction is null && !state.HasPendingStatus) || (state.IsSelected("Tag Target") && (!state.TargetHasBeenHit || Loadout?.HasSmartTracker != true)) || (state.MajorAction == "Ranged Attack" && !CanResolveAttack(actor, state)))" @onclick="() => ResolveRequested.InvokeAsync()">Resolve Actions</button>
            </div>
        }
        else { <p class="hint">Select a combatant in the tracker or double-click their token.</p> }
    </div>
    <section class="action-summary" aria-label="Combatant summary" aria-live="polite">
        <h2>Combatant Summary</h2>
        @if (CombatActionSummary.Create(Encounter, Actor, Entries, Loadout) is { } summary)
        {
            <dl>
                @foreach (var row in summary.Rows) { <dt>@row.Label</dt><dd>@row.Value</dd> }
            </dl>
        }
        else { <p class="hint">Select a combatant to see their summary.</p> }
    </section>
</aside>

@code {
    [Parameter] public EventCallback<(int Index, CombatCover? Cover)> AttackReactionCoverChanged { get; set; }
    private Task ChangeReactionCover(int index, ChangeEventArgs e) => AttackReactionCoverChanged.InvokeAsync((index, int.TryParse(e.Value?.ToString(), out var id) && covers.FirstOrDefault(c => c.Id == id) is { } cover ? new CombatCover(cover.Id, cover.Name, cover.Protection, cover.Hits) : null));
    private Task ChangeTargetReactionCover(ChangeEventArgs e) => TargetReactionCoverChanged.InvokeAsync(int.TryParse(e.Value?.ToString(), out var id) && covers.FirstOrDefault(c => c.Id == id) is { } cover ? new CombatCover(cover.Id, cover.Name, cover.Protection, cover.Hits) : null);
    [Parameter] public EventCallback<string> AutoAttackChanged { get; set; }
    [Parameter] public EventCallback<(int Index, int? TargetId)> AttackTargetChanged { get; set; }
    [Parameter] public EventCallback<(int Index, string Reaction)> AttackReactionChanged { get; set; }
    [Parameter] public EventCallback<(int Index, string Stance)> AttackReactionStanceChanged { get; set; }
    private static string FormatModifiers(IEnumerable<int> values)
    {
        var items = values.ToArray();
        return string.Join(" / ", (items.Distinct().Count() == 1 ? items.Take(1) : items).Select(v => v.ToString("+0;-0;0")));
    }
    private Task ChangeAutoAttack(ChangeEventArgs e) => AutoAttackChanged.InvokeAsync(e.Value?.ToString() ?? "Single");
    private Task ChangeAttackReaction(int index, ChangeEventArgs e) => AttackReactionChanged.InvokeAsync((index, e.Value?.ToString() ?? "None"));
    private Task ChangeAttackReactionStance(int index, ChangeEventArgs e) => AttackReactionStanceChanged.InvokeAsync((index, e.Value?.ToString() ?? "Standing"));
    private Task ChangeAttackTarget(int index, ChangeEventArgs e) => AttackTargetChanged.InvokeAsync((index, int.TryParse(e.Value?.ToString(), out var id) ? id : null));
    private string TargetLabel(SceneCombatant target) => target.Name + (Encounter.IsDead(target) ? " (Dead)" : Encounter.ActionFor(target.Id).Unconscious ? " (Unconscious)" : "") + (!target.IsVisible ? " (hidden)" : "");
    private bool CanResolveAttack(SceneCombatant actor, CombatantActionState state) => state.TargetId.HasValue && state.AttackTargets.Select((t,i) => (t,i)).Where(x => x.t.TargetId.HasValue).All(x => AttackModifierCalculator.Calculate(Encounter, actor, Entries, Loadout, x.i)?.CanResolve == true);
    private IReadOnlyList<CoverProtection> covers = [];
    private string? coverError;
    protected override async Task OnInitializedAsync()
    {
        try { covers = await CoverStore.ListAsync(); }
        catch (Exception) { coverError = "Unable to load cover protection."; }
    }
    private Task ChangeCoverProtection(ChangeEventArgs e) => CoverProtectionChanged.InvokeAsync(int.TryParse(e.Value?.ToString(), out var id) && covers.FirstOrDefault(c => c.Id == id) is { } cover ? new CombatCover(cover.Id, cover.Name, cover.Protection, cover.Hits) : null);
    [Parameter] public EventCallback<CombatCover?> CoverProtectionChanged { get; set; }
    [Parameter] public CombatLoadout? Loadout { get; set; }
    [Parameter] public int CampaignId { get; set; }
    [Parameter] public SceneCombatant? Actor { get; set; }
    [Parameter] public Encounter Encounter { get; set; } = new();
    [Parameter] public IReadOnlyList<SceneCombatant> Entries { get; set; } = [];
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool EquipDisabled { get; set; }
    [Parameter] public EventCallback DescribeRequested { get; set; }
    [Parameter] public EventCallback EquipRequested { get; set; }
    [Parameter] public EventCallback SkillsRequested { get; set; }
    [Parameter] public EventCallback<bool> CoverChanged { get; set; }
    [Parameter] public EventCallback<bool> HidingChanged { get; set; }
    [Parameter] public EventCallback<bool> UnconsciousChanged { get; set; }
    [Parameter] public EventCallback<bool> FlyingChanged { get; set; }
    [Parameter] public EventCallback<int> NaturalAttackChanged { get; set; }
    [Parameter] public EventCallback<bool> ElevatedChanged { get; set; }
    [Parameter] public EventCallback ResetRequested { get; set; }
    [Parameter] public EventCallback ResolveRequested { get; set; }
    [Parameter] public EventCallback<(int Column, string Action)> ActionSelected { get; set; }
    [Parameter] public EventCallback<int?> TargetChanged { get; set; }
    [Parameter] public EventCallback<string> StanceChanged { get; set; }
    [Parameter] public EventCallback<string> TargetReactionChanged { get; set; }
    [Parameter] public EventCallback<string> TargetReactionStanceChanged { get; set; }
    [Parameter] public EventCallback<CombatCover?> TargetReactionCoverChanged { get; set; }
    private static readonly (int Column, string Title, string[] Actions)[] Groups = [(1, "Minor Before", CombatActionChoices.Minor), (2, "Major Action", CombatActionChoices.Major), (3, "Minor After", CombatActionChoices.Minor)];
    private Task ChangeStance(ChangeEventArgs e) => StanceChanged.InvokeAsync(e.Value?.ToString() ?? "Standing");
    private Task ChangeReaction(ChangeEventArgs e) => TargetReactionChanged.InvokeAsync(e.Value?.ToString() ?? "None");
    private Task ChangeReactionStance(ChangeEventArgs e) => TargetReactionStanceChanged.InvokeAsync(e.Value?.ToString() ?? "Standing");
    private Task ChangeTarget(ChangeEventArgs e) => TargetChanged.InvokeAsync(int.TryParse(e.Value?.ToString(), out var id) ? id : null);
    private static string Initials(string name) => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0])).ToUpperInvariant();
}

