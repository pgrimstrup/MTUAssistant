@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject MTUAssistant.Services.MapPointerLocation PointerLocation

<div class="page" @ref="page">
    <div class="sidebar" id="main-navigation" @ref="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <button type="button" class="nav-panel-toggle" @ref="navToggle" aria-controls="main-navigation" aria-expanded="true" aria-label="Collapse navigation" title="Collapse navigation"><span aria-hidden="true">☰</span></button>
            <div class="map-location" aria-label="Map pointer location">
                @if (PointerLocation.Sector is { } sector)
                {
                    <span class="map-location-sector">@sector</span>
                    @if (PointerLocation.Subsector is { } subsector)
                    {
                        <span class="map-location-separator" aria-hidden="true"> / </span><span>@subsector</span>
                    }
                }
            </div>
            <CampaignControl />
            <div class="top-search"><SearchBox /></div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<TileRefreshDialog />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized() => PointerLocation.Changed += OnLocationChanged;
    private void OnLocationChanged() => _ = InvokeAsync(StateHasChanged);
    private ElementReference page, sidebar, navToggle;
    private IJSObjectReference? navigationModule;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        navigationModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/NavigationPanel.js");
        await navigationModule.InvokeVoidAsync("initialize", page, sidebar, navToggle);
    }
    public async ValueTask DisposeAsync()
    {
        PointerLocation.Changed -= OnLocationChanged;
        if (navigationModule is null) return;
        try { await navigationModule.InvokeVoidAsync("dispose", page); await navigationModule.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
