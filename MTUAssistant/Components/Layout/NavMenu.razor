@using MTUAssistant.Services
@inject TileRefreshService Refresh

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">MTUAssistant</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="travellers">
                <span class="bi bi-person-nav-menu" aria-hidden="true"></span> Travellers
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="trading">
                <span class="bi bi-arrow-left-right-nav-menu" aria-hidden="true"></span> Trading
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="passengers-cargo">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Passengers and Cargo
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <button type="button" class="nav-link" @onclick="Refresh.StartAsync">
                <span class="bi bi-arrow-repeat-nav-menu" aria-hidden="true"></span> Refresh Sector Data
            </button>
        </div>
    </nav>
</div>

