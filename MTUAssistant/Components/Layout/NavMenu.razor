@using MTUAssistant.Services
@implements IDisposable
@inject BattlemapState Battlemap


<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">MTUAssistant</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Galaxy Map
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="travellers">
                <span class="bi bi-person-nav-menu" aria-hidden="true"></span> Travellers
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="patrons-enemies">
                <span class="bi bi-person-nav-menu" aria-hidden="true"></span> Patrons and Enemies
            </NavLink>
        </div>
        <div class="nav-item px-3"><NavLink class="nav-link" href="scenes"><span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span>Scenes</NavLink></div>
        <div class="nav-item px-3">
            @if (Battlemap.Current is not null) { <NavLink class="nav-link" href="battlemap"><span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span>Battlemap</NavLink> }
            else { <span class="nav-link disabled-link" aria-disabled="true"><span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span>Battlemap</span> }
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="equipment">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Supply Catalog
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="trading">
                <span class="bi bi-arrow-left-right-nav-menu" aria-hidden="true"></span> Trading
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="passengers-cargo">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Passengers and Cargo
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="sector-data">
                <span class="bi bi-arrow-repeat-nav-menu" aria-hidden="true"></span> Refresh Sector Data
            </NavLink>
        </div>
    </nav>
</div>

@code {
    protected override void OnInitialized() => Battlemap.Changed += OnBattlemapChanged;
    private void OnBattlemapChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Battlemap.Changed -= OnBattlemapChanged;
}
