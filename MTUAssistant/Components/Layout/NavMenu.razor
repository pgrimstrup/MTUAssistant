@using MTUAssistant.Services
@implements IDisposable
@inject BattlemapState Battlemap


<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href=""><img class="brand-wordmark" src="images/traveller-mtu-transparent.png" alt="Traveller MTU" /></a>
    </div>
</div>



<div class="nav-scrollable">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink title="Galaxy Map" class="nav-link" href="" Match="NavLinkMatch.All"><span class="nav-glyph nav-glyph-galaxy-map" aria-hidden="true"></span><span class="nav-label">Galaxy Map</span></NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink title="Trading" class="nav-link" href="trading"><span class="nav-glyph nav-glyph-trading" aria-hidden="true"></span><span class="nav-label">Trading</span></NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink title="Passengers and Cargo" class="nav-link" href="passengers-cargo"><span class="nav-glyph nav-glyph-passengers-cargo" aria-hidden="true"></span><span class="nav-label">Passengers and Cargo</span></NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink title="Supply Catalog" class="nav-link" href="equipment"><span class="nav-glyph nav-glyph-supply-catalog" aria-hidden="true"></span><span class="nav-label">Supply Catalog</span></NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink title="Cover Protection" class="nav-link" href="cover-protection"><span class="nav-glyph nav-glyph-cover-protection" aria-hidden="true"></span><span class="nav-label">Cover Protection</span></NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink title="Travellers" class="nav-link" href="travellers"><span class="nav-glyph nav-glyph-travellers" aria-hidden="true"></span><span class="nav-label">Travellers</span></NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink title="Patrons and Enemies" class="nav-link" href="patrons-enemies"><span class="nav-glyph nav-glyph-patrons-enemies" aria-hidden="true"></span><span class="nav-label">Patrons and Enemies</span></NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink title="Animals and Creatures" class="nav-link" href="animals-creatures"><span class="nav-glyph nav-glyph-animals-creatures" aria-hidden="true"></span><span class="nav-label">Animals and Creatures</span></NavLink>
        </div>
        <div class="nav-item px-3"><NavLink title="Scenes" class="nav-link" href="scenes"><span class="nav-glyph nav-glyph-scenes" aria-hidden="true"></span><span class="nav-label">Scenes</span></NavLink></div>
        <div class="nav-item px-3">
            @if (Battlemap.Current is not null) { <NavLink title="Battlemap" class="nav-link" href="battlemap"><span class="nav-glyph nav-glyph-battlemap" aria-hidden="true"></span><span class="nav-label">Battlemap</span></NavLink> }
            else { <span class="nav-link disabled-link" aria-disabled="true" title="Battlemap"><span class="nav-glyph nav-glyph-battlemap" aria-hidden="true"></span><span class="nav-label">Battlemap</span></span> }
        </div>
        <div class="nav-item px-3">
            <NavLink title="Refresh Sector Data" class="nav-link" href="sector-data"><span class="nav-glyph nav-glyph-sector-refresh" aria-hidden="true"></span><span class="nav-label">Refresh Sector Data</span></NavLink>
        </div>
    </nav>
</div>

@code {
    protected override void OnInitialized() => Battlemap.Changed += OnBattlemapChanged;
    private void OnBattlemapChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Battlemap.Changed -= OnBattlemapChanged;
}
