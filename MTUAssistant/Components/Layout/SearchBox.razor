@implements IAsyncDisposable
@inject ISearchService Search
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="search">
    <input @ref="searchInput" type="search" class="form-control" placeholder="Search sectors, subsectors, systems…" autocomplete="off"
           aria-label="Search" value="@_text" @oninput="OnInput" @onkeydown="OnKeyDown" @onblur="Close" />
    @if (_open)
    {
        <ul class="results" role="listbox">
            @if (_results.Count == 0)
            {
                <li class="empty">No matches</li>
            }
            @for (var i = 0; i < _results.Count; i++)
            {
                var result = _results[i];
                <li class="@(i == _active ? "active" : null)" role="option"
                    @onmousedown="() => Select(result)" @onmousedown:preventDefault>@result.DisplayText</li>
            }
        </ul>
    }
</div>

@code {
    private const int DebounceMilliseconds = 250;

    private string _text = string.Empty;
    private IReadOnlyList<SearchResult> _results = [];
    private bool _open;
    private int _active = -1;
    private CancellationTokenSource? _cts;
    private ElementReference searchInput;
    private IJSObjectReference? inputModule;
    private bool selectTextAfterRender;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!selectTextAfterRender) return;
        try
        {
            inputModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/SearchInput.js");
            if (!selectTextAfterRender) return;
            selectTextAfterRender = false;
            await inputModule.InvokeVoidAsync("selectAll", searchInput);
        }
        catch (JSDisconnectedException) { }
    }

    private async Task OnInput(ChangeEventArgs e)
    {
        selectTextAfterRender = false;
        _text = e.Value?.ToString() ?? string.Empty;
        _cts?.Cancel();
        _cts?.Dispose();

        if (_text.Trim().Length < ISearchService.MinimumTermLength)
        {
            _results = [];
            _open = false;
            _cts = null;
            return;
        }

        var cts = _cts = new CancellationTokenSource();
        try
        {
            await Task.Delay(DebounceMilliseconds, cts.Token);
            _results = await Search.SearchAsync(_text, cts.Token);
            _active = -1;
            _open = true;
        }
        catch (OperationCanceledException)
        {
            // Superseded by a newer keystroke.
        }
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowDown" when _results.Count > 0:
                _active = (_active + 1) % _results.Count;
                break;
            case "ArrowUp" when _results.Count > 0:
                _active = (_active - 1 + _results.Count) % _results.Count;
                break;
            case "Enter" when _open && _results.Count > 0:
                Select(_results[Math.Max(0, _active)]);
                break;
            case "Escape":
                Close();
                break;
        }
    }

    private void Select(SearchResult result)
    {
        _cts?.Cancel();
        _text = result.DisplayText;
        selectTextAfterRender = true;
        Close();
        var target = result.SystemId > 0 ? $"system={result.SystemId}"
            : result.SubsectorId > 0 ? $"subsector={result.SubsectorId}"
            : $"sector={result.SectorId}";
        // Each selection, including a repeated one, creates a new navigation request.
        Navigation.NavigateTo($"{Navigation.BaseUri}?{target}&focus={Guid.NewGuid():N}");
    }

    private void Close() => _open = false;

    public async ValueTask DisposeAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        selectTextAfterRender = false;
        try
        {
            if (inputModule is not null) await inputModule.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }
}
